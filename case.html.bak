              </div>
            </div>
            {/* Desktop Toolbar */}
<div className="hidden md:flex justify-end px-12 lg:px-16 mt-6">
  <button
    onClick={() => setRegModal({ show: true, editData: null })}
    className="bg-blue-600 text-white px-6 py-3 rounded-xl font-bold shadow hover:shadow-lg hover:-translate-y-0.5 transition-all"
  >
    + New Patient
  </button>
</div>


<div className="px-6 md:px-12 lg:px-16 pb-40 pt-10 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">


              {loadingPatients && db.patients.length === 0 && (
                <div className="space-y-3">
                  {[1, 2, 3, 4, 5].map(i => (
                    <div key={i} className="glass-card animate-pulse">
                      <div className="flex items-center gap-4">
                        <div className="w-10 h-10 rounded-xl bg-slate-200"></div>
                        <div className="flex-1 space-y-2">
                          <div className="h-3 bg-slate-200 rounded w-1/2"></div>
                          <div className="h-2 bg-slate-100 rounded w-1/3"></div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              )}



              {filteredPatients.map(p => (
                <div
                  key={p.id}
                  onClick={() => {
                    setActivePatientId(p.id);
                    setView('TIMELINE');
                  }}
className="glass-card flex items-center justify-between cursor-pointer transition-all duration-200 hover:shadow-lg hover:-translate-y-1 active:scale-[0.98]"
 >
                  <div className="flex items-center gap-4">
                    <div
                      className={`w-10 h-10 rounded-xl flex items-center justify-center text-white font-black ${p.gender === 'F' ? 'bg-pink-500' : 'bg-slate-900'
                        }`}
                    >
                      {p.name.charAt(0)}
                    </div>
                    <div>
                      <h4 className="font-bold text-slate-800 text-sm md:text-base lg:text-lg">

                        {p.name}
                      </h4>
                      <p className="text-[10px] font-bold text-slate-400 uppercase tracking-tight">
                        #{p.regNo} • {p.age}Y • {p.gender}
                      </p>
                    </div>
                  </div>
                  <i className="fa-solid fa-chevron-right text-slate-200 text-xs"></i>
                </div>
              ))}
            </div>
          </div>

          {/* 🚀 FIXED BUTTON (NOT ANIMATED) */}
          <div className="fixed md:hidden bottom-0 left-0 right-0 z-50">


            {/* Gradient blur layer */}
