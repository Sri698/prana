className="w-full bg-white border border-slate-200 focus:border-blue-600 focus:ring-4 focus:ring-blue-100 rounded-2xl py-3.5 pl-11 pr-4 text-sm font-bold shadow-sm transition-all outline-none"
 placeholder="Search patient records..."
