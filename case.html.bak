              }}
              className="absolute bottom-[calc(1.5rem+env(safe-area-inset-bottom))] left-1/2 -translate-x-1/2 w-[85%] max-w-[380px] bg-[#0b1220] text-white h-14 rounded-2xl font-black flex items-center justify-center gap-2 shadow-2xl active:scale-[0.97] transition"
            >
              <i className="fa-solid fa-plus"></i>
              NEW PATIENT
            </button>

          </div>
{/* ===== MOBILE BURGER MENU PANEL ===== */}
{menuOpen && (
  <div className="fixed inset-0 z-[200] md:hidden">

    {/* Backdrop */}
    <div
      className="absolute inset-0 bg-black/40 backdrop-blur-sm"
      onClick={() => setMenuOpen(false)}
    ></div>

    {/* Slide Panel */}
    <div className="absolute top-0 left-0 right-0 bg-white rounded-b-3xl shadow-2xl p-6 space-y-4 animate-[fadeDown_0.25s_ease]">

      <div className="w-10 h-1 bg-slate-200 rounded-full mx-auto mb-4"></div>

      <button
        onClick={() => {
          setMenuOpen(false);
          setView("APPOINTMENTS");
        }}
        className="w-full flex items-center justify-between px-4 py-3 rounded-2xl bg-teal-50 hover:bg-teal-100 font-bold text-sm text-teal-900"
      >
        <span className="flex items-center gap-2"><i className="fa-solid fa-calendar-check text-teal-600"></i> Admin &amp; Appointments</span>
        <i className="fa-solid fa-chevron-right text-teal-400 text-xs"></i>
      </button>

      <button
        onClick={() => {
          setMenuOpen(false);
          setView("PHARMACY");
        }}
        className="w-full flex items-center justify-between px-4 py-3 rounded-2xl bg-slate-50 hover:bg-slate-100 font-bold text-sm"
      >
        <span className="flex items-center gap-2"><i className="fa-solid fa-pills text-amber-500"></i> Open Pharmacy</span>
        <i className="fa-solid fa-chevron-right text-slate-400 text-xs"></i>
      </button>

      <button
        onClick={() => {
          setMenuOpen(false);
          setView("PRESCRIPTION");
        }}
        className="w-full flex items-center justify-between px-4 py-3 rounded-2xl bg-purple-50 hover:bg-purple-100 font-bold text-sm text-purple-900"
      >
        <span className="flex items-center gap-2"><i className="fa-solid fa-file-prescription text-purple-600"></i> E-Prescriptions</span>
        <i className="fa-solid fa-chevron-right text-purple-400 text-xs"></i>
      </button>

    </div>
  </div>
)}

        </>
      );

    });
    const SECRET_KEY = "Prana_HomeoCare_2026_Pro_v1";

// ============================================================
// APPOINTMENTS & LIVE SCHEDULE ADMIN DASHBOARD COMPONENT
// ============================================================
// EXECUTIVE CLINICAL ADMIN DASHBOARD & APPOINTMENTS COMPONENT
// ============================================================
const AppointmentsAdmin = ({ db, setView, setActivePatientId, setRegModal }) => {
  const [appointments, setAppointments] = useState([]);
  const [loading, setLoading] = useState(true);
  const [activeTab, setActiveTab] = useState('SCHEDULE'); // 'SCHEDULE', 'FINANCES', 'SLOTS'
  const [filterMode, setFilterMode] = useState('ALL'); // 'ALL', 'IN_CLINIC', 'ONLINE'
  const [filterStatus, setFilterStatus] = useState('ALL');
  const [searchTerm, setSearchTerm] = useState('');
  const [refreshing, setRefreshing] = useState(false);
  const [copiedMeetId, setCopiedMeetId] = useState(null);

  // Holiday CRUD State
  const [holidays, setHolidays] = useState([]);
  const [loadingHolidays, setLoadingHolidays] = useState(false);
  const [newHoliday, setNewHoliday] = useState({
    holiday_date: '',
    title: '',
    scope: 'ALL_DAY'
  });
  const [savingHoliday, setSavingHoliday] = useState(false);

  // Timeslot Online/Offline & Availability Configuration State
  const [clinicMeetLink, setClinicMeetLink] = useState(() => {
    return null || 'https://meet.google.com/new';
  });

  const [slotModes, setSlotModes] = useState(() => {
    try {
      const saved = null;
      return saved ? JSON.parse(saved) : {};
    } catch(e) { return {}; }
  });

  const [showNewApptModal, setShowNewApptModal] = useState(false);
  const [newApptData, setNewApptData] = useState({
    name: '',
    age: '',
    phone: '',
    email: '',
    appointment_date: new Date().toISOString().split('T')[0],
    appointment_time: '10:00 AM',
    mode: 'In-Clinic (Kattupakkam)',
    concern: 'General Consultation',
    message: ''
  });
  const [savingAppt, setSavingAppt] = useState(false);

  const fetchAppointments = async () => {
    setLoading(true);
    try {
      let res = await fetch('book_appointment.php?action=list');
      if (!res.ok) {
        res = await fetch(`${API_BASE}/appointment.php?action=list`);
      }
      if (!res.ok) {
        res = await fetch(`${API_BASE}/appointment.php`);
      }
      if (res.ok) {
        const json = await res.json();
        if (json && Array.isArray(json.data)) {
          setAppointments(json.data);
          // localStorage.setItem('prana_cached_appointments', JSON.stringify(json.data));
          setLoading(false);
          return;
        }
      }
    } catch (e) {
      console.warn("Realtime appointment fetch notice:", e);
    }

    try {
      const cached = null;
      if (cached) {
        const parsed = JSON.parse(cached);
        if (Array.isArray(parsed)) {
          // Exclude any old demo data
          const realOnly = parsed.filter(p => p.id !== 101 && p.id !== 102 && p.id !== 103 && p.id !== 'PRN-9021');
          setAppointments(realOnly);
          setLoading(false);
          return;
        }
      }
    } catch(e) {}

    // No demo mock data — 100% realtime from database!
    setAppointments([]);
    setLoading(false);
  };

  const fetchHolidays = async () => {
    setLoadingHolidays(true);
    try {
      let res = await fetch('book_appointment.php?action=holidays');
      if (!res.ok) res = await fetch(`${API_BASE}/appointment.php?action=holidays`);
      if (res.ok) {
        const json = await res.json();
        if (json && Array.isArray(json.data)) {
          setHolidays(json.data);
          // localStorage.setItem('prana_cached_holidays', JSON.stringify(json.data));
          setLoadingHolidays(false);
          return;
        }
      }
    } catch(e) {}
    try {
      const cached = null;
      if (cached) {
        setHolidays(JSON.parse(cached));
      }
    } catch(e) {}
    setLoadingHolidays(false);
  };

  const fetchSlotConfig = async () => {
    try {
      let res = await fetch('book_appointment.php?action=slot_config');
      if (!res.ok) res = await fetch(`${API_BASE}/appointment.php?action=slot_config`);
      if (res.ok) {
        const json = await res.json();
        if (json && json.status === 'success' && json.data) {
          setSlotModes(prev => ({ ...prev, ...json.data }));
          // localStorage.setItem('prana_slot_config', JSON.stringify(json.data));
          return;
        }
      }
    } catch(e) {}
  };

  useEffect(() => {
    fetchAppointments();
    fetchHolidays();
    fetchSlotConfig();
  }, []);

  const handleAddHoliday = async (e) => {
    e.preventDefault();
    if (!newHoliday.holiday_date) return;
    setSavingHoliday(true);
    try {
      let res = await fetch('book_appointment.php?action=add_holiday', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newHoliday)
      });
      if (!res.ok) {
        await fetch(`${API_BASE}/appointment.php?action=add_holiday`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(newHoliday)
        });
      }
    } catch(e) {}
    const updated = [
      ...holidays.filter(h => h.holiday_date !== newHoliday.holiday_date),
      {
        id: Date.now(),
        holiday_date: newHoliday.holiday_date,
        title: newHoliday.title || 'Clinic Holiday',
        scope: newHoliday.scope
      }
    ].sort((a,b) => new Date(a.holiday_date) - new Date(b.holiday_date));
    setHolidays(updated);
    // localStorage.setItem('prana_cached_holidays', JSON.stringify(updated));
    setNewHoliday({ holiday_date: '', title: '', scope: 'ALL_DAY' });
    setSavingHoliday(false);
  };

  const handleDeleteHoliday = async (id, hDate) => {
    if (!confirm(`Are you sure you want to remove the holiday on ${hDate}?`)) return;
    try {
      let res = await fetch('book_appointment.php?action=delete_holiday', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, holiday_date: hDate })
      });
      if (!res.ok) {
        await fetch(`${API_BASE}/appointment.php?action=delete_holiday`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id, holiday_date: hDate })
        });
      }
    } catch(e) {}
    const updated = holidays.filter(h => h.id !== id && h.holiday_date !== hDate);
    setHolidays(updated);
    // localStorage.setItem('prana_cached_holidays', JSON.stringify(updated));
  };

  const toggleSlotConfig = async (timeStr, key) => {
    const cur = slotModes[timeStr] || { online: true, offline: true, enabled: true };
    const next = { ...cur };
    if (key === 'online') next.online = !next.online;
    if (key === 'offline') next.offline = !next.offline;
    if (key === 'enabled') next.enabled = !next.enabled;

    try {
      let res = await fetch('book_appointment.php?action=save_slot_config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slot_time: timeStr, ...next })
      });
      if (!res.ok) {
        res = await fetch(`${API_BASE}/appointment.php?action=save_slot_config`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slot_time: timeStr, ...next })
        });
      }
      const data = await res.json();
      if(data.status !== 'success') throw new Error(data.message || "Failed");
      
      const updated = { ...slotModes, [timeStr]: next };
      setSlotModes(updated);
    } catch(err) {
      alert("Failed to update slot config: " + err.message);
    }
  };

  // Calculate all consultation visits across all patients
  const allVisits = useMemo(() => {
    const list = [];
    if (db && db.patients) {
      const pts = Array.isArray(db.patients) ? db.patients : Object.values(db.patients);
      pts.forEach(p => {
        if (p && Array.isArray(p.history)) {
          p.history.forEach(v => {
            list.push({
              ...v,
              patientName: p.name || 'Patient',
              patientId: p.id || p.patient_uid,
              patientPhone: p.phone || '',
              regNo: p.regNo || p.reg_no || ''
            });
          });
        }
      });
    }
    return list.sort((a,b) => new Date(b.date || b.visit_date || 0) - new Date(a.date || a.visit_date || 0));
  }, [db]);

  const todayStr = new Date().toISOString().split('T')[0];
  const monthStr = todayStr.substring(0, 7);

  // Financial Metrics: Today's Sales and Monthly Sales
  const todaySales = useMemo(() => {
    return allVisits
      .filter(v => (v.date || v.visit_date || '').startsWith(todayStr))
      .reduce((sum, v) => sum + (parseFloat(v.moneyReceived || v.payment_amount || 0) || 0), 0);
  }, [allVisits, todayStr]);

  const monthSales = useMemo(() => {
    return allVisits
      .filter(v => (v.date || v.visit_date || '').startsWith(monthStr))
      .reduce((sum, v) => sum + (parseFloat(v.moneyReceived || v.payment_amount || 0) || 0), 0);
  }, [allVisits, monthStr]);

  const todayVisitsCount = useMemo(() => {
    return allVisits.filter(v => (v.date || v.visit_date || '').startsWith(todayStr)).length;
  }, [allVisits, todayStr]);

  const todayBookingsCount = useMemo(() => {
    return appointments.filter(a => (a.appointment_date || '').startsWith(todayStr)).length;
  }, [appointments, todayStr]);

  const totalPatients = useMemo(() => {
    if (!db || !db.patients) return 0;
    return Array.isArray(db.patients) ? db.patients.length : Object.keys(db.patients).length;
  }, [db]);

  const clinicCount = appointments.filter(a => !(a.mode || '').toLowerCase().includes('online') && !(a.mode || '').toLowerCase().includes('meet')).length;
  const onlineCount = appointments.filter(a => (a.mode || '').toLowerCase().includes('online') || (a.mode || '').toLowerCase().includes('meet')).length;

  const handleUpdateStatus = async (id, newStatus) => {
    const updated = appointments.map(a => a.id === id ? { ...a, status: newStatus } : a);
    setAppointments(updated);
    // localStorage.setItem('prana_cached_appointments', JSON.stringify(updated));

    try {
      await fetch(`${API_BASE}/appointment.php?action=status`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id, status: newStatus })
      });
    } catch (e) {
      console.warn("Status update note:", e);
    }
  };

  const handleWhatsAppChat = (phone, name, date, time, mode) => {
    const clean = (phone || '').replace(/\D/g, '');
    const num = clean.length === 10 ? '91' + clean : clean;
    const msg = `Hello ${name || 'Patient'}, Dr. G. Srinivasan (Prana Homeo Care) here regarding your consultation scheduled for ${date} at ${time} (${mode || 'In-Clinic'}).`;
    window.open(`https://wa.me/${num}?text=${encodeURIComponent(msg)}`, '_blank');
  };

  const copyMeetLink = (id, link) => {
    navigator.clipboard.writeText(link || 'https://meet.google.com/new');
    setCopiedMeetId(id);
    setTimeout(() => setCopiedMeetId(null), 2500);
  };

  const handleCreatePatientRecord = (appt) => {
    if (setRegModal) {
      setRegModal({
        show: true,
        editData: {
          name: appt.name || '',
          age: appt.age || '',
          phone: appt.phone || '',
          email: appt.email || '',
          complaints: `Initial Concern: ${appt.concern || ''}\nNotes: ${appt.message || ''}\nMode: ${appt.mode || 'In-Clinic'}`
        }
      });
    }
  };

  const handleSaveNewAppointment = async (e) => {
    e.preventDefault();
    setSavingAppt(true);

    const newObj = {
      id: Date.now(),
      ...newApptData,
      status: 'confirmed',
      meet_link: newApptData.mode.toLowerCase().includes('online') ? 'https://meet.google.com/new' : ''
    };

    try {
      const res = await fetch(`${API_BASE}/appointment.php`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(newApptData)
      });
      if (res.ok) {
        const json = await res.json();
        if (json && json.meet_link) {
          newObj.meet_link = json.meet_link;
        }
      }
    } catch (err) {
      console.warn("New appointment sync note:", err);
    }

    const updated = [newObj, ...appointments];
    setAppointments(updated);
    // localStorage.setItem('prana_cached_appointments', JSON.stringify(updated));
    setSavingAppt(false);
    setShowNewApptModal(false);
    setNewApptData({
      name: '',
      age: '',
      phone: '',
      email: '',
      appointment_date: new Date().toISOString().split('T')[0],
      appointment_time: '10:00 AM',
      mode: 'In-Clinic (Kattupakkam)',
      concern: 'General Consultation',
      message: ''
    });
  };

  const filtered = appointments.filter(a => {
    if (filterMode === 'IN_CLINIC' && !(a.mode || '').toLowerCase().includes('clinic')) return false;
    if (filterMode === 'ONLINE' && !(a.mode || '').toLowerCase().includes('online') && !(a.mode || '').toLowerCase().includes('meet')) return false;
    if (filterStatus === 'CONFIRMED' && a.status !== 'confirmed') return false;
    if (filterStatus === 'COMPLETED' && a.status !== 'completed') return false;
    if (searchTerm) {
      const s = searchTerm.toLowerCase();
      const match = (a.name || '').toLowerCase().includes(s) ||
                    (a.phone || '').toLowerCase().includes(s) ||
                    (a.concern || '').toLowerCase().includes(s);
      if (!match) return false;
    }
    return true;
  });

  const morningSlotKeys = ['10:00 AM', '10:30 AM', '11:00 AM', '11:30 AM', '12:00 PM', '12:30 PM'];
  const eveningSlotKeys = ['05:30 PM', '06:00 PM', '06:30 PM', '07:00 PM', '07:30 PM', '08:00 PM', '08:30 PM'];

  return (
    <div className="p-4 md:p-10 max-w-7xl mx-auto pb-32">
      {/* Header */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
          <div className="flex items-center gap-2">
            <span className="text-[11px] font-black tracking-widest uppercase text-teal-700 bg-teal-50 px-3 py-1 rounded-full border border-teal-200">
              Executive Medical Dashboard
            </span>
            <span className="text-[11px] font-bold text-amber-700 bg-amber-50 px-3 py-1 rounded-full border border-amber-200">
              Door of Hope
            </span>
          </div>
          <h1 className="text-[1.35rem] md:text-3xl font-black text-slate-900 mt-2 leading-tight">
            Clinic Operations &amp; Revenue
          </h1>
          <p className="text-[10px] md:text-xs font-semibold text-slate-500 mt-0.5 leading-relaxed">
            Dr. G. Srinivasan M.D(Hom) · Syncing Kattupakkam &amp; Online Consultations
          </p>
        </div>

        <div className="flex items-center gap-2 overflow-x-auto pb-2 -mx-2 px-2 w-full md:w-auto mt-2 md:mt-0 no-scrollbar">
          <button
            onClick={() => setShowNewApptModal(true)}
            className="flex-shrink-0 px-4 py-2.5 rounded-xl bg-[#073B42] hover:bg-[#0B5C66] text-white text-xs font-bold shadow-md shadow-teal-900/20 flex items-center gap-2 transition active:scale-95"
          >
            <i className="fa-solid fa-plus"></i>
            <span>New Appt</span>
          </button>

          <button
            onClick={() => setView('HOME')}
            className="flex-shrink-0 px-4 py-2.5 rounded-xl bg-slate-900 text-white text-xs font-bold shadow-md hover:bg-slate-800 transition flex items-center gap-2 active:scale-95"
          >
            <i className="fa-solid fa-users"></i>
            <span>Patients</span>
          </button>

          <button
            onClick={() => { setRefreshing(true); fetchAppointments().then(() => setRefreshing(false)); }}
            className="flex-shrink-0 px-4 py-2.5 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-700 shadow-sm hover:bg-slate-50 flex items-center gap-2 transition active:scale-95"
          >
            <i className={`fa-solid fa-arrows-rotate ${refreshing ? 'fa-spin text-[#073B42]' : 'text-slate-400'}`}></i>
            <span className="hidden sm:inline">Refresh</span>
          </button>
        </div>
      </div>

      {/* EXECUTIVE KPI METRIC CARDS GRID */}
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        {/* Today's Sales Card */}
        <div className="p-5 rounded-2xl bg-gradient-to-br from-white to-emerald-50/50 border border-emerald-100 shadow-sm">
          <div className="flex items-center justify-between mb-2">
            <span className="text-xs font-bold text-slate-500 uppercase tracking-wider">Today's Collections</span>
            <div className="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 flex items-center justify-center text-sm font-bold">
              ₹
            </div>
          </div>
          <div className="text-2xl font-black text-emerald-700">₹{todaySales.toLocaleString('en-IN')}</div>
          <div className="text-[11px] text-emerald-600 font-bold mt-1">
            {todayVisitsCount} consultations billed today
          </div>
        </div>

        {/* Monthly Sales Card */}
        <div className="p-5 rounded-2xl bg-gradient-to-br from-white to-blue-50/50 border border-blue-100 shadow-sm">
          <div className="flex items-center justify-between mb-2">
            <span className="text-xs font-bold text-slate-500 uppercase tracking-wider">Monthly Revenue</span>
            <div className="w-8 h-8 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center text-sm font-bold">
              <i className="fa-solid fa-chart-line"></i>
            </div>
          </div>
          <div className="text-2xl font-black text-blue-800">₹{monthSales.toLocaleString('en-IN')}</div>
          <div className="text-[11px] text-blue-600 font-bold mt-1">
            Month-to-Date Collections
          </div>
        </div>

        {/* Today's Bookings Card */}
        <div className="p-5 rounded-2xl bg-white border border-slate-100 shadow-sm">
          <div className="flex items-center justify-between mb-2">
            <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Today's Bookings</span>
            <div className="w-8 h-8 rounded-lg bg-teal-50 text-teal-600 flex items-center justify-center text-sm font-bold">
              <i className="fa-solid fa-calendar-day"></i>
            </div>
          </div>
          <div className="text-2xl font-black text-slate-900">{todayBookingsCount}</div>
          <div className="text-[11px] text-teal-600 font-bold mt-1">
            {appointments.length} Total Bookings in DB
          </div>
        </div>

        {/* Active Patients Card */}
        <div className="p-5 rounded-2xl bg-white border border-slate-100 shadow-sm">
          <div className="flex items-center justify-between mb-2">
            <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Patients</span>
            <div className="w-8 h-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center text-sm font-bold">
              <i className="fa-solid fa-hospital-user"></i>
            </div>
          </div>
          <div className="text-2xl font-black text-slate-900">{totalPatients}</div>
          <div className="text-[11px] text-purple-600 font-bold mt-1">
            Constitutional Case Sheets
          </div>
        </div>
      </div>

      {/* DASHBOARD TABS NAVIGATION */}
      <div className="flex items-center gap-2 border-b border-slate-200 mb-6 pb-2 overflow-x-auto">
        <button
          onClick={() => setActiveTab('SCHEDULE')}
          className={`px-4 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2 whitespace-nowrap ${
            activeTab === 'SCHEDULE'
              ? 'bg-slate-900 text-white shadow-sm'
              : 'text-slate-600 hover:bg-slate-100'
          }`}
        >
          <i className="fa-solid fa-calendar-check text-sm"></i>
          <span>Live Appointments ({appointments.length})</span>
        </button>

        <button
          onClick={() => setActiveTab('FINANCES')}
          className={`px-4 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2 whitespace-nowrap ${
            activeTab === 'FINANCES'
              ? 'bg-slate-900 text-white shadow-sm'
              : 'text-slate-600 hover:bg-slate-100'
          }`}
        >
          <i className="fa-solid fa-receipt text-sm"></i>
          <span>Financial Collections &amp; Sales</span>
        </button>

        <button
          onClick={() => setActiveTab('SLOTS')}
          className={`px-4 py-2.5 rounded-xl font-bold text-xs transition flex items-center gap-2 whitespace-nowrap ${
            activeTab === 'SLOTS'
              ? 'bg-slate-900 text-white shadow-sm'
              : 'text-slate-600 hover:bg-slate-100'
          }`}
        >
          <i className="fa-solid fa-calendar-xmark text-sm"></i>
          <span>Slots &amp; Holiday Manager ({holidays.length} Holidays)</span>
        </button>
      </div>

      {/* TAB 1: LIVE APPOINTMENTS & SCHEDULE */}
      {activeTab === 'SCHEDULE' && (
        <div>
          {/* Doctor Google Meet Consultation Room Banner */}
          <div className="flex flex-wrap items-center justify-between gap-3 p-4 mb-5 bg-gradient-to-r from-purple-50 to-indigo-50 border border-purple-200/90 rounded-2xl">
            <div className="flex items-center gap-3">
              <div className="w-10 h-10 rounded-xl bg-gradient-to-br from-purple-600 to-indigo-600 text-white flex items-center justify-center font-bold text-base shadow-sm">
                <i className="fa-solid fa-video"></i>
              </div>
              <div>
                <div className="flex items-center gap-2">
                  <span className="text-[10px] font-black uppercase tracking-wider text-purple-700 bg-purple-100/80 px-2 py-0.5 rounded-md">
                    Doctor Tele-Consultation Room
                  </span>
                  <span className="text-[11px] font-semibold text-emerald-700 flex items-center gap-1">
                    <span className="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> Active
                  </span>
                </div>
                <div className="text-xs font-semibold text-slate-700 mt-0.5">
                  Meeting Link: <span className="font-mono text-purple-950 font-bold select-all">{clinicMeetLink}</span>
                </div>
              </div>
            </div>
            <div className="flex items-center gap-2">
              <a
                href={clinicMeetLink}
                target="_blank"
                rel="noopener noreferrer"
                className="px-3.5 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white font-bold text-xs transition flex items-center gap-1.5 shadow-sm"
              >
                <i className="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
                <span>Open Doctor Room</span>
              </a>
              <button
                type="button"
                onClick={() => {
                  const newLink = prompt("Enter Doctor Google Meet Link / Code (e.g. https://meet.google.com/xxx-yyyy-zzz):", clinicMeetLink);
                  if (newLink && newLink.trim().startsWith('http')) {
                    setClinicMeetLink(newLink.trim());
                    // localStorage.setItem('prana_clinic_meet_link', newLink.trim());
                  }
                }}
                className="px-3 py-1.5 rounded-xl bg-white border border-purple-200 hover:bg-purple-100 text-purple-800 font-bold text-xs transition flex items-center gap-1"
              >
                <i className="fa-solid fa-pen-to-square text-[11px]"></i>
                <span>Change Link</span>
              </button>
            </div>
          </div>

          {/* Filters Bar */}
          <div className="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-6 bg-slate-50/70 p-3 rounded-2xl border border-slate-200/60">
            <div className="flex flex-wrap items-center gap-1.5">
              <button
                onClick={() => setFilterMode('ALL')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition ${filterMode === 'ALL' ? 'bg-white text-slate-900 shadow-sm' : 'text-slate-500 hover:text-slate-900'}`}
              >
                All ({appointments.length})
              </button>
              <button
                onClick={() => setFilterMode('IN_CLINIC')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 ${filterMode === 'IN_CLINIC' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-500 hover:text-slate-900'}`}
              >
                <span>🏥 In-Clinic ({clinicCount})</span>
              </button>
              <button
                onClick={() => setFilterMode('ONLINE')}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold transition flex items-center gap-1.5 ${filterMode === 'ONLINE' ? 'bg-purple-600 text-white shadow-sm' : 'text-slate-500 hover:text-slate-900'}`}
              >
                <span>🌐 Google Meet ({onlineCount})</span>
              </button>
            </div>

            <div className="flex items-center gap-2">
              <div className="relative">
                <i className="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input
                  type="text"
                  placeholder="Search patient or condition..."
                  value={searchTerm}
                  onChange={e => setSearchTerm(e.target.value)}
                  className="pl-8 pr-3 py-1.5 bg-white border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:border-teal-500 w-48 md:w-56"
                />
              </div>

              <select
                value={filterStatus}
                onChange={e => setFilterStatus(e.target.value)}
                className="px-3 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-700"
              >
                <option value="ALL">All Statuses</option>
                <option value="CONFIRMED">Confirmed Only</option>
                <option value="COMPLETED">Completed Only</option>
              </select>
            </div>
          </div>

          {/* Appointments List */}
          {loading ? (
            <div className="p-16 text-center bg-white rounded-3xl border border-slate-100 shadow-sm">
              <i className="fa-solid fa-circle-notch fa-spin text-2xl text-teal-600 mb-2"></i>
              <p className="text-xs font-bold text-slate-400 uppercase tracking-wider">Loading Appointments...</p>
            </div>
          ) : filtered.length === 0 ? (
            <div className="p-16 text-center bg-white rounded-3xl border border-slate-100 shadow-sm">
              <div className="w-16 h-16 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto mb-3 text-2xl">
                <i className="fa-regular fa-calendar-xmark"></i>
              </div>
              <h3 className="text-base font-bold text-slate-700">No Appointments In This Filter</h3>
              <p className="text-xs text-slate-400 mt-1">Switch filter tabs above or click "+ Book New Appointment" to record one.</p>
            </div>
          ) : (
            <div className="space-y-4">
              {filtered.map(a => {
                const isOnline = (a.mode || '').toLowerCase().includes('online') || (a.mode || '').toLowerCase().includes('meet');
                const meetLink = (typeof a.meet_link === "string" && a.meet_link.startsWith("http")) ? a.meet_link : (clinicMeetLink || "https://meet.google.com/new");
                return (
                  <div
                    key={a.id}
                    className="p-5 md:p-6 bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition flex flex-col lg:flex-row lg:items-center justify-between gap-4"
                  >
                    <div className="space-y-2 flex-1">
                      <div className="flex flex-wrap items-center gap-2">
                        <span className={`text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full border ${
                          isOnline
                            ? 'bg-purple-50 text-purple-700 border-purple-200'
                            : 'bg-blue-50 text-blue-700 border-blue-200'
                        }`}>
                          {isOnline ? '🌐 Google Meet Online' : '🏥 In-Clinic (Kattupakkam)'}
                        </span>

                        <span className={`text-[10px] font-black uppercase px-2.5 py-0.5 rounded-full ${
                          a.status === 'completed'
                            ? 'bg-slate-100 text-slate-600'
                            : 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                        }`}>
                          ● {a.status || 'Confirmed'}
                        </span>

                        <span className="text-xs font-bold text-slate-400">
                          📅 {a.appointment_date} · ⏰ {a.appointment_time}
                        </span>
                      </div>

                      <div className="flex items-baseline gap-3">
                        <h3 className="text-lg font-black text-slate-900">{a.name}</h3>
                        {a.age && <span className="text-xs font-bold text-slate-400">{a.age} Yrs</span>}
                        <span className="text-xs text-slate-500 font-semibold">📞 {a.phone}</span>
                        {a.email && <span className="text-xs text-slate-400 font-medium">✉️ {a.email}</span>}
                      </div>

                      {a.concern && (
                        <p className="text-xs font-bold text-teal-800 bg-teal-50/60 p-2 rounded-xl inline-block">
                          <i className="fa-solid fa-notes-medical mr-1 text-teal-600"></i>
                          <strong>Condition:</strong> {a.concern}
                        </p>
                      )}

                      {a.message && (
                        <p className="text-xs text-slate-500 italic line-clamp-2">
                          "{a.message}"
                        </p>
                      )}

                      {/* Display live meet room badge for online consultations */}
                      {isOnline && (
                        <div className="flex items-center gap-2 text-xs bg-purple-50/80 p-2 rounded-xl border border-purple-100 text-purple-900 max-w-fit">
                          <i className="fa-solid fa-video text-purple-600"></i>
                          <span className="font-semibold">Room:</span>
                          <span className="font-mono text-[11px] text-purple-700 select-all">{meetLink}</span>
                          <button
                            type="button"
                            onClick={() => copyMeetLink(a.id, meetLink)}
                            className="text-[10px] font-bold text-purple-600 hover:text-purple-900 ml-1 underline cursor-pointer"
                          >
                            {copiedMeetId === a.id ? '✓ Copied!' : 'Copy'}
                          </button>
                        </div>
                      )}
                    </div>

                    {/* Actions Bar */}
                    <div className="flex flex-wrap items-center gap-2 pt-2 lg:pt-0 border-t lg:border-t-0 border-slate-100">
                      {/* Prominent Google Meet Join Button */}
                      {isOnline && (
                        <a
                          href={meetLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          className="px-4 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white text-xs font-black shadow-md shadow-purple-500/20 transition flex items-center gap-2"
                          title="Open active Google Meet consultation room"
                        >
                          <i className="fa-solid fa-video text-sm"></i>
                          <span>Join Google Meet</span>
                        </a>
                      )}

                      <button
                        onClick={() => handleWhatsAppChat(a.phone, a.name, a.appointment_date, a.appointment_time, a.mode)}
                        className="px-3.5 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-bold transition flex items-center gap-1.5"
                        title="Send WhatsApp confirmation message"
                      >
                        <i className="fa-brands fa-whatsapp text-emerald-600 text-sm"></i>
                        <span>WhatsApp</span>
                      </button>

                      <button
                        onClick={() => handleCreatePatientRecord(a)}
                        className="px-3.5 py-2 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-800 text-xs font-bold transition flex items-center gap-1.5"
                        title="Open Registration Modal prefilled with appointment data"
                      >
                        <i className="fa-solid fa-user-plus text-blue-600 text-xs"></i>
                        <span>Create Case Sheet</span>
                      </button>

                      {a.status !== 'completed' ? (
                        <button
                          onClick={() => handleUpdateStatus(a.id, 'completed')}
                          className="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition"
                          title="Mark appointment completed"
                        >
                          <i className="fa-solid fa-check text-xs"></i>
                        </button>
                      ) : (
                        <button
                          onClick={() => handleUpdateStatus(a.id, 'confirmed')}
                          className="px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition"
                          title="Re-open appointment"
                        >
                          <i className="fa-solid fa-rotate-left text-xs"></i>
                        </button>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {/* TAB 2: FINANCIAL COLLECTIONS & SALES */}
      {activeTab === 'FINANCES' && (
        <div className="space-y-6">
          <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div className="p-6 rounded-2xl bg-white border border-slate-100 shadow-sm">
              <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Today's Total Receipts</span>
              <div className="text-3xl font-black text-emerald-700 mt-2">₹{todaySales.toLocaleString('en-IN')}</div>
              <p className="text-xs text-slate-500 font-medium mt-1">{todayVisitsCount} patient consultations today</p>
            </div>

            <div className="p-6 rounded-2xl bg-white border border-slate-100 shadow-sm">
              <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Monthly Total Receipts</span>
              <div className="text-3xl font-black text-blue-800 mt-2">₹{monthSales.toLocaleString('en-IN')}</div>
              <p className="text-xs text-slate-500 font-medium mt-1">Collections across current calendar month</p>
            </div>

            <div className="p-6 rounded-2xl bg-white border border-slate-100 shadow-sm">
              <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Recorded Consultations</span>
              <div className="text-3xl font-black text-slate-900 mt-2">{allVisits.length}</div>
              <p className="text-xs text-slate-500 font-medium mt-1">Across all clinic patient records</p>
            </div>
          </div>

          {/* Visits Ledger Table */}
          {allVisits.length === 0 ? (
            <div className="p-16 text-center bg-white rounded-3xl border border-slate-100 shadow-sm">
              <i className="fa-solid fa-file-invoice-dollar text-3xl text-slate-300 mb-2"></i>
              <p className="text-xs font-bold text-slate-400 uppercase tracking-wider">No Billing Entries Recorded Yet</p>
            </div>
          ) : (
            <div className="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
              <div className="p-4 bg-slate-50 border-b border-slate-100 font-bold text-xs text-slate-700 flex items-center justify-between">
                <span>Recent Consultation Receipts Ledger</span>
                <span className="text-slate-400 text-[11px]">Sorted latest first</span>
              </div>
              <div className="overflow-x-auto">
                <table className="w-full text-left text-xs">
                  <thead className="bg-slate-50/60 text-slate-400 font-bold uppercase text-[10px] tracking-wider border-b border-slate-100">
                    <tr>
                      <th className="py-3 px-4">Date</th>
                      <th className="py-3 px-4">Patient Name</th>
                      <th className="py-3 px-4">Reg No</th>
                      <th className="py-3 px-4">Chief Complaint</th>
                      <th className="py-3 px-4">Prescription</th>
                      <th className="py-3 px-4 text-right">Fee Collected</th>
                      <th className="py-3 px-4 text-center">Action</th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100 font-medium text-slate-700">
                    {allVisits.slice(0, 50).map((v, idx) => (
                      <tr key={idx} className="hover:bg-slate-50/70 transition">
                        <td className="py-3 px-4 font-bold text-slate-900 whitespace-nowrap">{v.date || v.visit_date}</td>
                        <td className="py-3 px-4 font-bold">{v.patientName}</td>
                        <td className="py-3 px-4 text-slate-400">{v.regNo || '—'}</td>
                        <td className="py-3 px-4 max-w-xs truncate text-slate-500">{v.complaints || v.symptoms || 'General'}</td>
                        <td className="py-3 px-4 font-mono text-teal-800 font-semibold">{v.prescription || v.rx || '—'}</td>
                        <td className="py-3 px-4 text-right font-black text-emerald-700">
                          ₹{parseFloat(v.moneyReceived || v.payment_amount || 0).toLocaleString('en-IN')}
                        </td>
                        <td className="py-3 px-4 text-center">
                          <button
                            onClick={() => {
                              if (v.patientId) {
                                setActivePatientId(v.patientId);
                                setView('CASE');
                              }
                            }}
                            className="px-2.5 py-1 rounded-lg bg-teal-50 hover:bg-teal-100 text-teal-800 font-bold text-[11px] transition"
                          >
                            Open Chart
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>
      )}

      {/* TAB 3: SLOTS & CLINIC HOLIDAY MANAGER */}
      {activeTab === 'SLOTS' && (
        <div className="space-y-8">
          {/* Header Banner */}
          <div className="p-6 rounded-2xl bg-gradient-to-r from-slate-900 via-teal-950 to-slate-900 text-white shadow-md flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <span className="text-[10px] font-black uppercase tracking-widest text-teal-400">Live Practice Control</span>
              <h3 className="text-xl font-black text-white mt-1">Available Timeslots &amp; Holiday CRUD Manager</h3>
              <p className="text-xs text-slate-300 mt-1 max-w-xl">
                Configure Online vs In-Clinic availability for morning &amp; evening slots, or register clinic holidays to instantly block dates on the website booking form.
              </p>
            </div>
          </div>

          {/* SECTION 1: HOLIDAY CRUD CONTROLS */}
          <div className="bg-white rounded-3xl p-6 md:p-8 border border-slate-100 shadow-sm space-y-6">
            <div className="flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-100 pb-4">
              <div>
                <h4 className="text-base font-black text-slate-900 flex items-center gap-2">
                  <i className="fa-solid fa-calendar-xmark text-rose-500"></i>
                  <span>Clinic Holidays &amp; Scheduled Closures</span>
                </h4>
                <p className="text-xs text-slate-500 mt-0.5">
                  Dates registered here will automatically vanish all appointment slots on the patient booking page.
                </p>
              </div>
              <span className="text-xs font-bold text-rose-700 bg-rose-50 px-3 py-1 rounded-full border border-rose-200">
                {holidays.length} Active Holidays
              </span>
            </div>

            {/* Add Holiday Form */}
            <form onSubmit={handleAddHoliday} className="bg-slate-50 p-4 md:p-5 rounded-2xl border border-slate-200/70 text-xs font-bold grid grid-cols-1 md:grid-cols-4 gap-3 items-end">
              <div>
                <label className="text-slate-700 block mb-1">Holiday Date *</label>
                <input
                  type="date"
                  required
                  min={new Date().toISOString().split('T')[0]}
                  value={newHoliday.holiday_date}
                  onChange={e => setNewHoliday({ ...newHoliday, holiday_date: e.target.value })}
                  className="w-full px-3 py-2 bg-white rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                />
              </div>

              <div>
                <label className="text-slate-700 block mb-1">Reason / Festival Name *</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. Diwali Holiday, Renovation"
                  value={newHoliday.title}
                  onChange={e => setNewHoliday({ ...newHoliday, title: e.target.value })}
                  className="w-full px-3 py-2 bg-white rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                />
              </div>

              <div>
                <label className="text-slate-700 block mb-1">Closure Scope</label>
                <select
                  value={newHoliday.scope}
                  onChange={e => setNewHoliday({ ...newHoliday, scope: e.target.value })}
                  className="w-full px-3 py-2 bg-white rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                >
                  <option value="ALL_DAY">Full Day Closed</option>
                  <option value="MORNING">Morning Only (Evening Open)</option>
                  <option value="EVENING">Evening Only (Morning Open)</option>
                </select>
              </div>

              <div>
                <button
                  type="submit"
                  disabled={savingHoliday}
                  className="w-full py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold transition flex items-center justify-center gap-2 shadow-sm"
                >
                  {savingHoliday ? <i className="fa-solid fa-spinner fa-spin"></i> : <i className="fa-solid fa-plus"></i>}
                  <span>Add Clinic Holiday</span>
                </button>
              </div>
            </form>

            {/* Existing Holidays List */}
            {loadingHolidays ? (
              <div className="p-8 text-center text-xs text-slate-400">Loading clinic holidays...</div>
            ) : holidays.length === 0 ? (
              <div className="p-6 text-center text-xs text-slate-400 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                No holidays scheduled. Clinic is operating regular practice schedule.
              </div>
            ) : (
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                {holidays.map((h, idx) => (
                  <div key={h.id || idx} className="p-4 rounded-2xl bg-white border border-rose-100 shadow-sm flex items-center justify-between gap-3">
                    <div>
                      <div className="flex items-center gap-2">
                        <span className="text-[11px] font-black text-rose-700 bg-rose-50 px-2 py-0.5 rounded-md border border-rose-200">
                          📅 {h.holiday_date}
                        </span>
                        <span className="text-[10px] font-bold text-slate-500 uppercase">
                          {h.scope === 'MORNING' ? 'Morning Off' : h.scope === 'EVENING' ? 'Evening Off' : 'Full Day'}
                        </span>
                      </div>
                      <h5 className="font-bold text-slate-800 text-xs mt-1">{h.title || 'Clinic Holiday'}</h5>
                    </div>
                    <button
                      type="button"
                      onClick={() => handleDeleteHoliday(h.id, h.holiday_date)}
                      className="w-8 h-8 rounded-xl bg-slate-50 hover:bg-rose-100 text-slate-400 hover:text-rose-700 transition flex items-center justify-center text-xs font-bold"
                      title="Delete this holiday"
                    >
                      <i className="fa-solid fa-trash"></i>
                    </button>
                  </div>
                ))}
              </div>
            )}
          </div>

          {/* SECTION 2: TIMESLOT SELECTION CONTROLS FOR ONLINE & OFFLINE */}
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
            {/* Morning Session Controls */}
            <div className="p-6 rounded-3xl bg-white border border-slate-100 shadow-sm space-y-4">
              <div className="flex items-center justify-between border-b border-slate-100 pb-3">
                <div className="flex items-center gap-2">
                  <span className="w-3 h-3 rounded-full bg-amber-500"></span>
                  <h4 className="font-black text-slate-900 text-sm">Morning Slots (10:00 AM – 1:00 PM)</h4>
                </div>
                <span className="text-[11px] font-bold text-amber-800 bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200">
                  Mon – Sun
                </span>
              </div>
              <p className="text-xs text-slate-500">
                Toggle online video / in-clinic availability or turn off individual morning slots:
              </p>
              <div className="space-y-2">
                {morningSlotKeys.map(timeStr => {
                  const cfg = slotModes[timeStr] || { online: true, offline: true, enabled: true };
                  return (
                    <div
                      key={timeStr}
                      className={`p-3 rounded-xl border transition flex items-center justify-between gap-3 ${
                        cfg.enabled ? 'bg-amber-50/40 border-amber-200/80' : 'bg-slate-50 border-slate-200 opacity-60'
                      }`}
                    >
                      <span className="font-bold text-xs text-slate-800">{timeStr}</span>
                      <div className="flex items-center gap-1.5 text-[10px] font-bold">
                        <button
                          type="button"
                          onClick={() => toggleSlotConfig(timeStr, 'online')}
                          className={`px-2.5 py-1 rounded-lg border transition flex items-center gap-1 ${
                            cfg.online ? 'bg-purple-100 text-purple-800 border-purple-300' : 'bg-white text-slate-400 border-slate-200'
                          }`}
                        >
                          <span>🌐 Video</span>
                        </button>
                        <button
                          type="button"
                          onClick={() => toggleSlotConfig(timeStr, 'offline')}
                          className={`px-2.5 py-1 rounded-lg border transition flex items-center gap-1 ${
                            cfg.offline ? 'bg-blue-100 text-blue-800 border-blue-300' : 'bg-white text-slate-400 border-slate-200'
                          }`}
                        >
                          <span>🏥 Clinic</span>
                        </button>
                        <button
                          type="button"
                          onClick={() => toggleSlotConfig(timeStr, 'enabled')}
                          className={`px-2 py-1 rounded-lg font-bold transition ${
                            cfg.enabled ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-600'
                          }`}
                        >
                          {cfg.enabled ? 'Active' : 'Off'}
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>

            {/* Evening Session Controls */}
            <div className="p-6 rounded-3xl bg-white border border-slate-100 shadow-sm space-y-4">
              <div className="flex items-center justify-between border-b border-slate-100 pb-3">
                <div className="flex items-center gap-2">
                  <span className="w-3 h-3 rounded-full bg-teal-600"></span>
                  <h4 className="font-black text-slate-900 text-sm">Evening Slots (5:30 PM – 9:00 PM)</h4>
                </div>
                <span className="text-[11px] font-bold text-teal-800 bg-teal-50 px-2.5 py-0.5 rounded-full border border-teal-200">
                  Mon – Sat
                </span>
              </div>
              <p className="text-xs text-slate-500">
                Toggle online video / in-clinic availability or turn off individual evening slots:
              </p>
              <div className="space-y-2">
                {eveningSlotKeys.map(timeStr => {
                  const cfg = slotModes[timeStr] || { online: true, offline: true, enabled: true };
                  return (
                    <div
                      key={timeStr}
                      className={`p-3 rounded-xl border transition flex items-center justify-between gap-3 ${
                        cfg.enabled ? 'bg-teal-50/40 border-teal-200/80' : 'bg-slate-50 border-slate-200 opacity-60'
                      }`}
                    >
                      <span className="font-bold text-xs text-slate-800">{timeStr}</span>
                      <div className="flex items-center gap-1.5 text-[10px] font-bold">
                        <button
                          type="button"
                          onClick={() => toggleSlotConfig(timeStr, 'online')}
                          className={`px-2.5 py-1 rounded-lg border transition flex items-center gap-1 ${
                            cfg.online ? 'bg-purple-100 text-purple-800 border-purple-300' : 'bg-white text-slate-400 border-slate-200'
                          }`}
                        >
                          <span>🌐 Video</span>
                        </button>
                        <button
                          type="button"
                          onClick={() => toggleSlotConfig(timeStr, 'offline')}
                          className={`px-2.5 py-1 rounded-lg border transition flex items-center gap-1 ${
                            cfg.offline ? 'bg-blue-100 text-blue-800 border-blue-300' : 'bg-white text-slate-400 border-slate-200'
                          }`}
                        >
                          <span>🏥 Clinic</span>
                        </button>
                        <button
                          type="button"
                          onClick={() => toggleSlotConfig(timeStr, 'enabled')}
                          className={`px-2 py-1 rounded-lg font-bold transition ${
                            cfg.enabled ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-600'
                          }`}
                        >
                          {cfg.enabled ? 'Active' : 'Off'}
                        </button>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* QUICK NEW APPOINTMENT MODAL */}
      {showNewApptModal && (
        <div className="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-lg w-full p-6 md:p-8 shadow-2xl border border-slate-100 max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between mb-6">
              <div>
                <h3 className="text-xl font-black text-slate-900">Book Patient Appointment</h3>
                <p className="text-xs text-slate-400 mt-0.5">Record a walk-in, phone caller, or online video consultation</p>
              </div>
              <button
                onClick={() => setShowNewApptModal(false)}
                className="w-8 h-8 rounded-full bg-slate-100 text-slate-400 hover:text-slate-600 flex items-center justify-center font-bold text-sm"
              >
                ✕
              </button>
            </div>

            <form onSubmit={handleSaveNewAppointment} className="space-y-4 text-xs font-bold">
              <div>
                <label className="text-slate-700 block mb-1">Patient Full Name *</label>
                <input
                  type="text"
                  required
                  value={newApptData.name}
                  onChange={e => setNewApptData({ ...newApptData, name: e.target.value })}
                  placeholder="e.g. Rahul Sharma"
                  className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-slate-700 block mb-1">Age / Category</label>
                  <input
                    type="text"
                    value={newApptData.age}
                    onChange={e => setNewApptData({ ...newApptData, age: e.target.value })}
                    placeholder="e.g. 28 or Child"
                    className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                  />
                </div>
                <div>
                  <label className="text-slate-700 block mb-1">Mobile (WhatsApp) *</label>
                  <input
                    type="tel"
                    required
                    value={newApptData.phone}
                    onChange={e => setNewApptData({ ...newApptData, phone: e.target.value })}
                    placeholder="e.g. 9884223007"
                    className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                  />
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-slate-700 block mb-1">Date *</label>
                  <input
                    type="date"
                    required
                    value={newApptData.appointment_date}
                    onChange={e => setNewApptData({ ...newApptData, appointment_date: e.target.value })}
                    className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                  />
                </div>
                <div>
                  <label className="text-slate-700 block mb-1">Time Slot *</label>
                  <select
                    value={newApptData.appointment_time}
                    onChange={e => setNewApptData({ ...newApptData, appointment_time: e.target.value })}
                    className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                  >
                    <option value="10:00 AM">10:00 AM (Morning)</option>
                    <option value="10:30 AM">10:30 AM (Morning)</option>
                    <option value="11:00 AM">11:00 AM (Morning)</option>
                    <option value="11:30 AM">11:30 AM (Morning)</option>
                    <option value="12:00 PM">12:00 PM (Morning)</option>
                    <option value="12:30 PM">12:30 PM (Morning)</option>
                    <option value="05:30 PM">05:30 PM (Evening)</option>
                    <option value="06:00 PM">06:00 PM (Evening)</option>
                    <option value="06:30 PM">06:30 PM (Evening)</option>
                    <option value="07:00 PM">07:00 PM (Evening)</option>
                    <option value="07:30 PM">07:30 PM (Evening)</option>
                    <option value="08:00 PM">08:00 PM (Evening)</option>
                    <option value="08:30 PM">08:30 PM (Evening)</option>
                  </select>
                </div>
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="text-slate-700 block mb-1">Consultation Mode *</label>
                  <select
                    value={newApptData.mode}
                    onChange={e => setNewApptData({ ...newApptData, mode: e.target.value })}
                    className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                  >
                    <option value="In-Clinic (Kattupakkam)">🏥 In-Clinic Visit</option>
                    <option value="Online Video (Google Meet)">🌐 Online Video (Google Meet)</option>
                  </select>
                </div>
                <div>
                  <label className="text-slate-700 block mb-1">Email Address</label>
                  <input
                    type="email"
                    value={newApptData.email}
                    onChange={e => setNewApptData({ ...newApptData, email: e.target.value })}
                    placeholder="patient@example.com"
                    className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                  />
                </div>
              </div>

              <div>
                <label className="text-slate-700 block mb-1">Primary Health Concern</label>
                <input
                  type="text"
                  value={newApptData.concern}
                  onChange={e => setNewApptData({ ...newApptData, concern: e.target.value })}
                  placeholder="e.g. Paediatric Adenoids, Eczema, PCOS, Asthma"
                  className="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                />
              </div>

              <div>
                <label className="text-slate-700 block mb-1">Notes / Complaints</label>
                <textarea
                  rows="2"
                  value={newApptData.message}
                  onChange={e => setNewApptData({ ...newApptData, message: e.target.value })}
                  placeholder="Additional patient notes..."
                  className="w-full px-3.5 py-2 rounded-xl border border-slate-200 focus:outline-none focus:border-teal-500 font-semibold"
                ></textarea>
              </div>

              <div className="flex items-center justify-end gap-2 pt-2">
                <button
                  type="button"
                  onClick={() => setShowNewApptModal(false)}
                  className="px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  disabled={savingAppt}
                  className="px-5 py-2.5 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-bold flex items-center gap-2"
                >
                  {savingAppt && <i className="fa-solid fa-spinner fa-spin"></i>}
                  <span>Save Appointment</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
};


    const App = () => {
      const [db, setDb] = useState({ patients: [] });


      const [view, setView] = useState(null);
      const [authChecking, setAuthChecking] = useState(true);

      useEffect(() => {
        if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.App) {
          window.Capacitor.Plugins.App.addListener('backButton', () => {
            setView(prev => {
              if (prev !== 'DASHBOARD' && prev !== 'HOME') return 'DASHBOARD';
              if (prev === 'DASHBOARD') window.Capacitor.Plugins.App.exitApp();
              return prev;
            });
          });
        }
      }, []);



      const [clinic, setClinic] = useState(null);
      const [backendType, setBackendType] = useState('LOCAL'); // 'MYSQL' or 'LOCAL'

      const [activePatientId, setActivePatientId] = useState(null);
      const [activeVisitId, setActiveVisitId] = useState(null);
      const [search, setSearch] = useState('');
      const [regModal, setRegModal] = useState({ show: false, editData: null });
      const [savingPatient, setSavingPatient] = useState(false);
      const [loadingPatients, setLoadingPatients] = useState(false);
// ================= PHARMACY STATE =================
const [pharmacy, setPharmacy] = useState([]);
const [loadingPharmacy, setLoadingPharmacy] = useState(false);
// ================= PHARMACY MODAL =================
const [pharmacyModal, setPharmacyModal] = useState({
  show: false,
  editData: null
});

      const [appAlert, setAppAlert] = useState(null);
      const [confirmModal, setConfirmModal] = useState({
        show: false,
        title: '',
        message: '',
        onConfirm: null
      });
      
      useEffect(() => {
        // Detect MySQL backend availability
        checkMySqlHealth().then(health => {
          if (health && health.database && health.database.connected) {
            setBackendType('MYSQL');
          } else {
            setBackendType('LOCAL');
          }
        });

        // Simply show the login screen by default since Firebase is disabled
        setView("LOGIN");
        setAuthChecking(false);
      }, []);


      // ================= DATABASE FUNCTIONS =================

      const savePatientRTDB = async (patient) => {
        if (!clinic) return;

        const id = rtdb.ref().push().key;

        await rtdb
          .ref(`clinics/${clinic}/patients/${id}`)
          .set({ ...patient, id });

        return id;
      };

      const deleteVisitRTDB = async (patientId, visitId) => {
        if (!clinic) return;
        try {
          await fetch(`${API_BASE}/visits.php?id=${encodeURIComponent(visitId)}`, { method: 'DELETE' });
        } catch(e) {}
        if (rtdb) {
          try {
            await rtdb
              .ref(`clinics/${clinic}/patients/${patientId}/visits/${visitId}`)
              .remove();
          } catch(e) {}
        }
      };


      // Capacitor Status Bar Logic
      useEffect(() => {
        if (window.Capacitor && window.Capacitor.Plugins.StatusBar) {
          const { StatusBar } = window.Capacitor.Plugins;
          StatusBar.setOverlaysWebView({ overlay: false });
          StatusBar.setBackgroundColor({ color: '#f8fafc' });
        }
      }, [clinic]);

      const patient = useMemo(() => {
        return db?.patients?.find(p => p.id === activePatientId) || null;
      }, [db, activePatientId]);

      const visit = useMemo(() => {
        return patient?.history?.find(v => v.id === activeVisitId) || null;
      }, [patient, activeVisitId]);
      useEffect(() => {
        if (!clinic) return;
        setLoadingPatients(true);

        // Function to load from MySQL
        const loadFromMySql = async () => {
          try {
            const res = await fetch(`${API_BASE}/patients.php?clinic=${encodeURIComponent(clinic)}&search=${encodeURIComponent(search)}`);
            if (res.ok) {
              const result = await res.json();
              if (result && result.status === 'success' && Array.isArray(result.data)) {
                setDb(prev => ({
                  ...prev,
                  patients: result.data
                }));
                // Cache locally for offline backup
                try {
                  const encrypted = CryptoJS.AES.encrypt(JSON.stringify(result.data), SECRET_KEY).toString();
                  // localStorage.setItem(`prana_patients_${clinic}`, encrypted);
                } catch(e) {}
                setLoadingPatients(false);
                setBackendType('MYSQL');
                return true;
              }
            }
          } catch(e) {}
          return false;
        };

        // Attempt MySQL first
        loadFromMySql().then(success => {
          if (!success) {
            // Fallback: Load from local encrypted storage
            try {
              const localData = null;
              if (localData) {
                const bytes = CryptoJS.AES.decrypt(localData, SECRET_KEY);
                const decrypted = JSON.parse(bytes.toString(CryptoJS.enc.Utf8));
                if (Array.isArray(decrypted)) {
                  setDb(prev => ({ ...prev, patients: decrypted }));
                }
              }
            } catch(e) {}

            // Also listen to RTDB if available
            if (rtdb) {
              const ref = rtdb.ref(`clinics/${clinic}/patients`).limitToLast(500);
              ref.on("value", snapshot => {
                const data = snapshot.val() || {};
                const newPatients = Object.values(data);
                setDb(prev => {
                  const historiesMap = {};
                  (prev?.patients || []).forEach(p => {
                    if (p.history && Array.isArray(p.history) && p.history.length > 0) {
                      historiesMap[p.id] = p.history;
                    }
                  });
                  const updated = newPatients.map(p => ({
                    ...p,
                    history: historiesMap[p.id] || p.history || (p.visits ? Object.values(p.visits).sort((a,b)=>(b.createdAt||0)-(a.createdAt||0)) : [])
                  }));
                  return { ...prev, patients: updated };
                });
              });
            }
            setLoadingPatients(false);
          }
        });
      }, [clinic, search]);
// ================= PHARMACY LISTENER (MYSQL + LOCAL) =================
useEffect(() => {
  if (!clinic) return;
  setLoadingPharmacy(true);

  const loadPharmacy = async () => {
    try {
      const res = await fetch(`${API_BASE}/pharmacy.php?clinic=${encodeURIComponent(clinic)}`);
      if (res.ok) {
        const result = await res.json();
        if (result && result.status === 'success' && Array.isArray(result.data)) {
          setPharmacy(result.data);
          try {
            const encrypted = CryptoJS.AES.encrypt(JSON.stringify(result.data), SECRET_KEY).toString();
            // localStorage.setItem(`prana_pharmacy_${clinic}`, encrypted);
          } catch(e) {}
          setLoadingPharmacy(false);
          return true;
        }
      }
    } catch(e) {}
    return false;
  };

  loadPharmacy().then(success => {
    if (!success) {
      try {
        const local = null;
        if (local) {
          const bytes = CryptoJS.AES.decrypt(local, SECRET_KEY);
          const decrypted = JSON.parse(bytes.toString(CryptoJS.enc.Utf8));
          if (Array.isArray(decrypted)) setPharmacy(decrypted);
        }
      } catch(e) {}
      setLoadingPharmacy(false);
    }
  });
}, [clinic]);

      useEffect(() => {
        if (!activePatientId || !clinic) return;

        let activeListener = true;

        const loadVisitsFromMySql = async () => {
          try {
            const res = await fetch(`${API_BASE}/visits.php?patient_id=${encodeURIComponent(activePatientId)}`);
            if (res.ok) {
              const result = await res.json();
              if (result && result.status === 'success' && Array.isArray(result.data)) {
                if (activeListener) {
                  setDb(prev => ({
                    ...prev,
                    patients: prev.patients.map(p =>
                      p.id === activePatientId ? { ...p, history: result.data } : p
                    )
                  }));
                }
                return true;
              }
            }
          } catch(e) {}
          return false;
        };

        loadVisitsFromMySql().then(loaded => {
          if (!loaded && rtdb) {
            const ref = rtdb.ref(
              `clinics/${clinic}/patients/${activePatientId}/visits`
            );
            ref.on("value", snapshot => {
              if (!activeListener) return;
              const val = snapshot.val();
              if (!val || Object.keys(val).length === 0) return;
              const visits = Object.values(val)
                .sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
              setDb(prev => ({
                ...prev,
                patients: prev.patients.map(p =>
                  p.id === activePatientId ? { ...p, history: visits } : p
                )
              }));
            });
          }
        });

        return () => { activeListener = false; };
      }, [activePatientId, clinic]);




      // ✅ 🔥 ADD THIS RIGHT HERE
      useEffect(() => {
        if (view === "HOME") {
          const el = document.getElementById("appContainer");
          if (el) {
            requestAnimationFrame(() => {
              el.scrollTop = 0;
            });
          }
        }
      }, [view]);



      const savePatient = async (formData) => {
        if (savingPatient || !clinic) return;

        // Duplicate Reg ID check
        const isDuplicate = (db.patients || []).some(
          p => String(p.regNo) === String(formData.regNo) && p.id !== (regModal.editData?.id)
        );

        if (isDuplicate) {
          setAppAlert(`Reg ID #${formData.regNo} is already registered. Please use a different ID.`);
          return;
        }

        setSavingPatient(true);

        try {
          const patientId = regModal.editData?.id || ('p_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6));

          const cleanPatientObj = {
            ...formData,
            id: patientId,
            branch: clinic,
            clinic: clinic,
            regDate: formData.regDate || regModal.editData?.regDate || new Date().toISOString().slice(0, 10),
            history: regModal.editData?.history || []
          };

          // 1. Immediately update React state & encrypted local storage
          setDb(prev => {
            const current = prev.patients || [];
            const idx = current.findIndex(p => p.id === patientId);
            let updated;
            if (idx >= 0) {
              updated = [...current];
              updated[idx] = { ...updated[idx], ...cleanPatientObj };
            } else {
              updated = [cleanPatientObj, ...current];
            }
            try {
              const enc = CryptoJS.AES.encrypt(JSON.stringify(updated), SECRET_KEY).toString();
              // localStorage.setItem(`prana_patients_${clinic}`, enc);
            } catch(e) {}
            return { ...prev, patients: updated };
          });

          // 2. Sync to MySQL API
          try {
            await fetch(`${API_BASE}/patients.php`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                ...cleanPatientObj,
                clinic: clinic,
                branch: clinic
              })
            });
          } catch (e) {
            console.warn("MySQL patient sync notice:", e);
          }

          // 3. Sync to Firebase RTDB if available
          if (rtdb) {
            try {
              if (regModal.editData) {
                await rtdb.ref(`clinics/${clinic}/patients/${patientId}`).update(formData);
              } else {
                await rtdb.ref(`clinics/${clinic}/patients/${patientId}`).set({ ...cleanPatientObj, id: patientId });
              }
            } catch(e) {
              console.warn("RTDB sync notice:", e);
            }
          }

          // 4. Navigate to Timeline & close modal
          setActivePatientId(patientId);
          setView("TIMELINE");
          setRegModal({ show: false, editData: null });
        } catch (err) {
          console.error("Save patient error:", err);
          setAppAlert("Error saving patient. Please try again.");
        } finally {
          setSavingPatient(false);
        }
      };


// ================= PHARMACY CRUD =================
const saveMedicine = async (formData) => {
  if (!clinic) return;

  const id = formData.id || ('m_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6));
  const qty = Number(formData.quantity) || 0;
  const minLvl = Number(formData.minStock) || Number(formData.reorderLevel) || 10;
  const medData = {
    ...formData,
    id,
    branch: clinic,
    clinic: clinic,
    quantity: qty,
    minStock: minLvl,
    reorderLevel: minLvl
  };

  try {
    await fetch(`${API_BASE}/pharmacy.php`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(medData)
    });
  } catch(e) {
    console.warn("Pharmacy save error:", e);
  }

  setPharmacy(prev => {
    const existing = prev.findIndex(m => m.id === id);
    let updated;
    if (existing >= 0) {
      updated = [...prev];
      updated[existing] = medData;
    } else {
      updated = [medData, ...prev];
    }
    try {
      const enc = CryptoJS.AES.encrypt(JSON.stringify(updated), SECRET_KEY).toString();
      // localStorage.setItem(`prana_pharmacy_${clinic}`, enc);
    } catch(e) {}
    return updated;
  });

  if (rtdb) {
    try {
      await rtdb
        .ref(`clinics/${clinic}/pharmacy/${id}`)
        .set({
          ...medData,
          createdAt: new Date().toISOString()
        });
    } catch(e) {}
  }

  setPharmacyModal({ show: false, editData: null });
};

const deleteMedicine = async (id) => {
  if (!clinic) return;

  try {
    await fetch(`${API_BASE}/pharmacy.php?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
  } catch(e) {}

  setPharmacy(prev => {
    const updated = prev.filter(m => m.id !== id);
    try {
      const enc = CryptoJS.AES.encrypt(JSON.stringify(updated), SECRET_KEY).toString();
      // localStorage.setItem(`prana_pharmacy_${clinic}`, enc);
    } catch(e) {}
    return updated;
  });

  if (rtdb) {
    try {
      await rtdb
        .ref(`clinics/${clinic}/pharmacy/${id}`)
        .remove();
    } catch(e) {}
  }
};

      const deletePatient = (id) => {
        setConfirmModal({
          show: true,
          title: "Delete Patient",
          message: "All consultations will be permanently removed. Continue?",
          onConfirm: async () => {
            try {
              await fetch(`${API_BASE}/patients.php?id=${encodeURIComponent(id)}`, { method: 'DELETE' });
            } catch(e) {}
            setDb(prev => {
              const updated = prev.patients.filter(p => p.id !== id);
              try {
                const enc = CryptoJS.AES.encrypt(JSON.stringify(updated), SECRET_KEY).toString();
                // localStorage.setItem(`prana_patients_${clinic}`, enc);
              } catch(e) {}
              return { ...prev, patients: updated };
            });
            if (rtdb) {
              try {
                await rtdb
                  .ref(`clinics/${clinic}/patients/${id}`)
                  .remove();
              } catch(e) {}
            }

            setView("HOME");
          }
        });
      };

      const Timeline = ({ patient }) => {

