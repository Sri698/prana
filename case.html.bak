      const RxSection = React.memo(({ title, type, list, update, add, remove, theme, isSos }) => {
        return (

          <section className="space-y-3">
            <div className="flex justify-between items-center">
              <label className={`text-[10px] font-black text-${theme === 'blue' ? 'blue' : theme === 'red' ? 'red' : 'slate'}-500 uppercase tracking-[0.2em]`}>{title}</label>
              <button onClick={() => add(type)} className="text-[10px] font-black text-slate-400 uppercase">+ Add Row</button>
            </div>
            <div className="space-y-2">
              {list.map((rx, i) => (
                <div key={i} className="space-y-2 bg-slate-50/50 border border-slate-100 p-3 rounded-2xl">
                  <div className="flex gap-2">
                    <input className="flex-1 bg-transparent font-bold text-sm outline-none" placeholder="Remedy & Potency" value={rx.name} onChange={e => update(type, i, 'name', e.target.value)} />
                    <input className="w-24 bg-transparent font-bold text-sm outline-none border-l border-slate-200 pl-2 text-blue-600" placeholder="Dosage" value={rx.dose} onChange={e => update(type, i, 'dose', e.target.value)} />
                    <i onClick={() => remove(type, i)} className="fa-solid fa-xmark text-slate-300 ml-2"></i>
                  </div>
                  {isSos && (
                    <input className="w-full bg-red-50/50 border border-red-100 rounded-lg px-3 py-1.5 text-[11px] font-semibold text-red-700 outline-none" placeholder="SOS Condition / Remarks..." value={rx.remarks} onChange={e => update(type, i, 'remarks', e.target.value)} />
                  )}
                </div>
              ))}
            </div>
          </section>
        );
      });
     const MindQuestion = ({ label, field, form, setForm, options }) => {
  return (
    <div>
      <label className="text-[10px] font-bold text-slate-500 uppercase block mb-2">
        {label}
      </label>

      <div className="flex flex-wrap gap-2">
        {options.map(opt => {
          const isSelected = form[field] === opt;

          return (
            <button
              key={opt}
              type="button"
              onClick={() => {
                setForm({
                  ...form,
                  [field]: isSelected ? "" : opt
                });
              }}
              className={`px-3 py-1.5 text-[11px] font-bold rounded-full transition ${
                isSelected
                  ? "bg-blue-600 text-white shadow"
                  : "bg-white border border-slate-200 text-slate-500 hover:bg-slate-100"
              }`}
            >
              {opt}
            </button>
          );
        })}
      </div>
    </div>
  );
};
const AdvancedMindSelector = ({ form, setForm }) => {

  const toggle = (section, label) => {
    const value = `${section} → ${label}`;
    const exists = form.mindRubrics.includes(value);

    if (exists) {
      setForm({
        ...form,
        mindRubrics: form.mindRubrics.filter(r => r !== value)
      });
    } else {
      setForm({
        ...form,
        mindRubrics: [...form.mindRubrics, value]
      });
    }
  };

  return (
    <div className="space-y-6">

      <label className="text-[10px] font-black text-slate-400 uppercase block">
        Advanced Rubric Selection
      </label>

      <div className="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

        {Object.entries(Mind).map(([section, items]) => (

          <div
            key={section}
            className="bg-white border border-slate-200 rounded-2xl shadow-sm"
          >

            {/* SECTION HEADER */}
            <div className="px-4 py-3 border-b border-slate-100">
              <h4 className="text-[11px] font-black text-slate-700 uppercase tracking-wider">
                {section.replace(/([A-Z])/g, " $1").trim()}
              </h4>
            </div>

            {/* RUBRIC LIST */}
            <div className="max-h-[220px] overflow-y-auto p-3 space-y-2">

              {items.map(label => {
                const value = `${section} → ${label}`;
                const selected = form.mindRubrics.includes(value);

                return (
                  <button
                    key={label}
                    type="button"
                    onClick={() => toggle(section, label)}
                    className={`w-full text-left px-3 py-2 rounded-lg text-[11px] font-semibold transition ${
                      selected
                        ? "bg-blue-600 text-white"
                        : "hover:bg-slate-100 text-slate-600"
                    }`}
                  >
                    {label}
                  </button>
                );
              })}

            </div>
          </div>

        ))}

      </div>
    </div>
  );
};
const AdvancedGeneralsSelector = ({ form, setForm }) => {

  const [activeChapter, setActiveChapter] = React.useState(
    Object.keys(Rubrics)[0]
  );
const [chapterOpen, setChapterOpen] = React.useState(false);

  const [search, setSearch] = React.useState("");

  const toggle = (chapter, section, item) => {
    const value = `${chapter} → ${section} → ${item}`;
    const exists = form.generalRubrics.includes(value);

    if (exists) {
      setForm({
        ...form,
        generalRubrics: form.generalRubrics.filter(r => r !== value)
      });
    } else {
      setForm({
        ...form,
        generalRubrics: [...form.generalRubrics, value]
      });
    }
  };

  return (
    <div className="space-y-6">

      {/* Top Bar */}
      <div className="flex flex-col md:flex-row gap-3 md:items-center md:justify-between">
<div className="relative">

  <button
    type="button"
    onClick={() => setChapterOpen(prev => !prev)}
    className="bg-white border border-slate-200 rounded-2xl px-5 py-2 text-xs font-bold uppercase tracking-wide shadow-sm hover:shadow transition flex items-center gap-2"
  >
    {activeChapter.replace(/([A-Z])/g, " $1")}
    <i className={`fa-solid fa-chevron-down text-[10px] transition ${chapterOpen ? "rotate-180" : ""}`}></i>
  </button>

{chapterOpen && (
  <div className="absolute mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 overflow-hidden z-50 animate-[fadeDown_0.18s_ease]">

      {Object.keys(Rubrics).map(chapter => (
        <button
          key={chapter}
          type="button"
          onClick={() => {
            setActiveChapter(chapter);
            setChapterOpen(false);
          }}
          className={`w-full text-left px-5 py-3 text-[11px] font-semibold transition ${
            activeChapter === chapter
              ? "bg-blue-600 text-white"
              : "hover:bg-slate-100 text-slate-600"
          }`}
        >
          {chapter.replace(/([A-Z])/g, " $1")}
        </button>
      ))}

    </div>
  )}

</div>



        <input
          type="text"
          placeholder="Search rubrics..."
          value={search}
          onChange={e => setSearch(e.target.value)}
          className="flex-1 bg-slate-100 rounded-xl px-4 py-2 text-xs font-semibold outline-none"
        />

        <div className="text-xs font-bold text-green-600">
          Selected: {form.generalRubrics.length}
        </div>

      </div>

      {/* Sections */}
      {Object.entries(Rubrics[activeChapter]).map(([section, items]) => {

        const filteredItems = items.filter(item =>
          item.toLowerCase().includes(search.toLowerCase())
        );

        if (filteredItems.length === 0) return null;

        return (
          <div key={section} className="space-y-3">

            <h4 className="text-xs font-black uppercase text-slate-500 tracking-wider">
              {section.replace(/([A-Z])/g, " $1")}
            </h4>

            <div className="flex flex-wrap gap-2">

              {filteredItems.map(item => {
                const value = `${activeChapter} → ${section} → ${item}`;
                const selected = form.generalRubrics.includes(value);

                return (
                  <button
                    key={item}
                    onClick={() => toggle(activeChapter, section, item)}
                    className={`px-3 py-1.5 text-[11px] font-semibold rounded-full transition
                      ${
                        selected
                          ? "bg-green-600 text-white shadow"
                          : "bg-white border border-slate-200 hover:bg-slate-100 text-slate-600"
                      }`}
                  >
                    {item}
                  </button>
                );
              })}

            </div>

          </div>
        );
      })}

    </div>
  );
};



      const Report = React.memo(() => {

        const [previewImage, setPreviewImage] = useState(null);
        const [downloadToast, setDownloadToast] = useState(false);

        const downloadImage = async (url, filename) => {
          try {
            const res = await fetch(url);
            const blob = await res.blob();

            // ✅ Mobile: use Web Share API (triggers Android/iOS save to gallery)
            if (navigator.canShare && navigator.canShare({ files: [new File([blob], filename, { type: blob.type })] })) {
              const file = new File([blob], filename, { type: blob.type });
              await navigator.share({ files: [file], title: filename });
              setDownloadToast(true);
              setTimeout(() => setDownloadToast(false), 2500);
              return;
            }

            // ✅ Desktop: blob download
            const blobUrl = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = blobUrl;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(blobUrl);
            setDownloadToast(true);
            setTimeout(() => setDownloadToast(false), 2500);
          } catch (err) {
            console.error('Download failed:', err);
          }
        };

        if (!patient || !visit) return null;




        const generatePDF = async () => {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();
  doc.setFont("helvetica", "normal");
  doc.setFontSize(10);


  const margin = 20;
  const pageWidth = 210;
  const contentWidth = pageWidth - margin * 2;
  const pageHeight = 297;
  let y = 25;

  const addPageIfNeeded = (space = 10) => {
    if (y + space > pageHeight - 20) {
      doc.addPage();
      y = 25;
    }
  };

  const sectionHeader = (title, color = [241, 245, 249]) => {
    addPageIfNeeded(20);

    doc.setFillColor(...color);
    doc.roundedRect(margin, y - 6, contentWidth, 14, 3, 3, "F");

    doc.setFont("helvetica", "bold");
    doc.setTextColor(15, 23, 42);
    doc.text(title, margin + 6, y + 2);

    doc.setFont("helvetica", "normal");
    y += 16;
  };

  const labelValue = (label, value) => {
    addPageIfNeeded(10);
    doc.setFont("helvetica", "bold");
    doc.text(label, margin + 2, y);
    doc.setFont("helvetica", "normal");
    doc.text(value || "---", margin + 60, y);
    y += 8;
  };

  const paragraphBlock = (text) => {
    const split = doc.splitTextToSize(text || "---", contentWidth - 10);
    doc.text(split, margin + 5, y);
    y += split.length * 6 + 4;
  };

  const divider = () => {
    doc.setDrawColor(226, 232, 240);
    doc.line(margin, y, pageWidth - margin, y);
    y += 10;
  };

  // ================= HEADER =================
  doc.setFont("helvetica", "bold");
  doc.setFontSize(18);
  doc.setTextColor(15, 23, 42);
  doc.text("PRANA HOMEO CARE", pageWidth / 2, y, { align: "center" });

  y += 6;

  doc.setFontSize(9);
  doc.setFont("helvetica", "normal");
  doc.setTextColor(100, 100, 100);
  doc.setFont("helvetica", "italic");
  doc.setFontSize(9);
  doc.setTextColor(181, 141, 55);
  doc.text("DOOR OF HOPE — DR. G. SRINIVASAN M.D.(Hom)", pageWidth / 2, y, { align: "center" });
  y += 5;
  doc.setFont("helvetica", "normal");
  doc.setFontSize(8.5);
  doc.setTextColor(100, 100, 100);
  doc.text("Comprehensive Clinical Case History & Repertory Assessment", pageWidth / 2, y, { align: "center" });

  y += 12;
  divider();

  // ================= PATIENT DETAILS =================
  sectionHeader("Patient Information", [241, 245, 249]);

  labelValue("Name:", patient.name);
  labelValue("Registration ID:", patient.regNo);
  labelValue("Age / Gender:", `${patient.age} / ${patient.gender}`);
  labelValue("Phone:", patient.phone);
  labelValue("Address:", patient.address);

  y += 6;

  // ================= VISIT DETAILS =================
  sectionHeader("Consultation Summary", [248, 250, 252]);

  labelValue("Consultation Date:", visit.date);

  // Complaints
  if (visit.complaints?.length) {
    doc.setFont("helvetica", "bold");
    doc.text("Chief Complaints:", margin + 2, y);
    y += 8;

    doc.setFont("helvetica", "normal");

    visit.complaints.forEach(c => {
      const split = doc.splitTextToSize(c, contentWidth - 10);
      doc.text(split, margin + 8, y);
      y += split.length * 6 + 4;
      addPageIfNeeded(10);
    });
  }

  y += 4;

  // Family History
  doc.setFont("helvetica", "bold");
  doc.text("Family History:", margin + 2, y);
  y += 8;
  doc.setFont("helvetica", "normal");
  paragraphBlock(visit.familyHistory);

  y += 6;

  // ================= MIND SECTION =================
  if (
    visit.anxiety ||
    visit.fear ||
    visit.irritability ||
    visit.company ||
    visit.contradiction ||
    visit.mindRubrics?.length
  ) {
    sectionHeader("Mental Assessment", [224, 242, 254]);

    labelValue("Anxiety:", visit.anxiety);
    labelValue("Dominant Fear:", visit.fear);
    labelValue("Irritability:", visit.irritability);
    labelValue("Company Preference:", visit.company);
    labelValue("Reaction to Contradiction:", visit.contradiction);

    if (visit.mindRubrics?.length) {
      y += 4;
      doc.setFont("helvetica", "bold");
      doc.text("Selected Mental Rubrics:", margin + 2, y);
      y += 8;
      doc.setFont("helvetica", "normal");

      visit.mindRubrics.forEach(r => {
        const clean = r.replace(/→/g, " > ");
        const split = doc.splitTextToSize(clean, contentWidth - 10);
        doc.text(split, margin + 8, y);
        y += split.length * 6 + 4;
        addPageIfNeeded(10);
      });
    }

    y += 6;
  }

  // ================= GENERALS SECTION =================
  if (
    visit.thermal ||
    visit.thirst ||
    visit.appetite ||
    visit.sweat ||
    visit.sleepQuality ||
    visit.generalRubrics?.length
  ) {
    sectionHeader("General Physical Generals", [236, 253, 245]);

    labelValue("Thermal Reaction:", visit.thermal);
    labelValue("Thirst:", visit.thirst);
    labelValue("Appetite:", visit.appetite);
    labelValue("Perspiration:", visit.sweat);
    labelValue("Sleep Quality:", visit.sleepQuality);
    labelValue("Time Aggravation:", visit.timeAggravation);

    if (visit.generalRubrics?.length) {
      y += 4;
      doc.setFont("helvetica", "bold");
      doc.text("Selected General Rubrics:", margin + 2, y);
      y += 8;
      doc.setFont("helvetica", "normal");

      visit.generalRubrics.forEach(r => {
        const clean = r.replace(/→/g, " > ");
        const split = doc.splitTextToSize(clean, contentWidth - 10);
        doc.text(split, margin + 8, y);
        y += split.length * 6 + 4;
        addPageIfNeeded(10);
      });
    }

    y += 6;
  }

  // ================= REMARKS =================
  sectionHeader("Clinical Remarks", [254, 243, 199]);
  paragraphBlock(visit.remarks);

  // ================= PRESCRIPTION =================
  const medicineSection = (title, list) => {
    if (!list?.[0]?.name) return;

    sectionHeader(title, [243, 244, 246]);

    list.forEach(rx => {
      const line = `${rx.name} — ${rx.dose}` + (rx.remarks ? ` (${rx.remarks})` : "");
      const split = doc.splitTextToSize(line, contentWidth - 10);
      doc.text(split, margin + 8, y);
      y += split.length * 6 + 6;
      addPageIfNeeded(10);
    });
  };

  medicineSection("Main Prescription", visit.mainRx);
  medicineSection("Supportive Medicines", visit.supportRx);
  medicineSection("SOS / Emergency", visit.sosRx);
// ================= PAYMENT SECTION =================
if (visit.moneyReceived !== undefined && visit.moneyReceived !== "") {
  sectionHeader("Payment Details", [220, 252, 231]); // light green background

  labelValue("Amount:", `₹${visit.moneyReceived}`);
  labelValue("Mode:", visit.paymentMode || "---");
  labelValue("Notes:", visit.paymentNotes || "---");

  y += 6;
}
  const fileName = `${patient.name}_Clinical_Report.pdf`;
  doc.save(fileName);
};

        return (
          <div className="p-6 md:p-12 min-h-screen max-w-4xl mx-auto">


            <header className="flex justify-between items-center mb-6">
              <button onClick={() => setView('TIMELINE')} className="w-9 h-9 rounded-lg bg-slate-50 flex items-center justify-center"><i className="fa-solid fa-arrow-left"></i></button>
              <button onClick={generatePDF} className="bg-blue-600 text-white px-4 py-2 rounded-lg font-black text-[10px] uppercase">Export PDF</button>
            </header>
            <div className="glass-card mb-6">
              <p className="text-[10px] font-black text-blue-500 uppercase mb-2">{visit.date}</p>
              <div className="mb-4 space-y-2">
                {(visit.complaints || []).map((c, i) => (
                  <div key={i} className="bg-slate-50 p-3 rounded-xl text-sm font-semibold text-slate-800">
                    {c}
                  </div>
                ))}
              </div>
<div className="border-t border-slate-100 pt-6 space-y-6">

  {/* ===== MIND SECTION ===== */}
  {(visit.anxiety || visit.fear || visit.irritability || visit.company || visit.contradiction || visit.mindRubrics?.length > 0) && (
    <div className="bg-blue-50/40 border border-blue-100 rounded-2xl p-5 space-y-4">

      <h3 className="text-xs font-black text-blue-600 uppercase tracking-wider">
        Mind Assessment
      </h3>

      {/* Structured Q&A */}
      <div className="grid md:grid-cols-2 gap-4">
        {[
          { label: "Anxiety", field: "anxiety" },
          { label: "Dominant Fear", field: "fear" },
          { label: "Irritability", field: "irritability" },
          { label: "Company Preference", field: "company" },
          { label: "Reaction to Contradiction", field: "contradiction" }
        ].map(q =>
          visit[q.field] ? (
            <div key={q.field}>
              <p className="text-[10px] font-black text-slate-400 uppercase">{q.label}</p>
              <p className="text-sm font-bold text-slate-800">{visit[q.field]}</p>
            </div>
          ) : null
        )}
      </div>

      {/* Selected Rubrics */}
      {visit.mindRubrics?.length > 0 && (
        <div className="pt-3 border-t border-blue-100">
          <p className="text-[10px] font-black text-purple-600 uppercase mb-2">
            Selected Rubrics
          </p>

          <div className="flex flex-wrap gap-2">
            {visit.mindRubrics.map((r, i) => (
              <span
                key={i}
                className="px-3 py-1 text-[11px] bg-white border border-purple-200 rounded-full font-semibold text-slate-700"
              >
                {r}
              </span>
            ))}
          </div>
        </div>
      )}

    </div>
  )}

  {/* ===== GENERALS SECTION ===== */}
  {(visit.thermal || visit.thirst || visit.sweat || visit.generalRubrics?.length > 0) && (
    <div className="bg-green-50/40 border border-green-100 rounded-2xl p-5 space-y-4">

      <h3 className="text-xs font-black text-green-600 uppercase tracking-wider">
        Generals
      </h3>

      <div className="grid md:grid-cols-2 gap-4">
        {[
          { label: "Thermal", field: "thermal" },
          { label: "Thirst", field: "thirst" },
          { label: "Perspiration", field: "sweat" },
          { label: "Sleep Quality", field: "sleepQuality" },
          { label: "Time Aggravation", field: "timeAggravation" }
        ].map(q =>
          visit[q.field] ? (
            <div key={q.field}>
              <p className="text-[10px] font-black text-slate-400 uppercase">{q.label}</p>
              <p className="text-sm font-bold text-slate-800">{visit[q.field]}</p>
            </div>
          ) : null
        )}
      </div>

      {visit.generalRubrics?.length > 0 && (
        <div className="pt-3 border-t border-green-100">
          <p className="text-[10px] font-black text-green-600 uppercase mb-2">
            Advanced Generals Rubrics
          </p>

          <div className="flex flex-wrap gap-2">
            {visit.generalRubrics.map((r, i) => (
              <span
                key={i}
                className="px-3 py-1 text-[11px] bg-white border border-green-200 rounded-full font-semibold text-slate-700"
              >
                {r}
              </span>
            ))}
          </div>
        </div>
      )}

    </div>
  )}

</div>



              {/* Remarks full width */}
              <div className="border-t border-slate-100 pt-4 mt-4">
                <label className="text-[9px] font-black text-slate-400 uppercase">
                  Remarks
                </label>
                <p className="text-xs font-bold mt-1">
                  {visit.remarks || '---'}
                </p>
              </div>

            </div>
            {Array.isArray(visit.images) && visit.images.length > 0 && (
              <div className="grid grid-cols-3 gap-3 mb-6">
                {visit.images.map((url, i) => (
                  <div key={i} className="relative group">
                    <img
                      src={url}
                      onClick={() => setPreviewImage(url)}
                      className="rounded-xl border object-cover h-24 w-full cursor-pointer"
                    />
                    <button
                      onClick={e => { e.stopPropagation(); downloadImage(url, `${patient.name}_image_${i + 1}.jpg`); }}
                      className="absolute bottom-1 right-1 bg-black/60 hover:bg-black/80 text-white rounded-lg px-2 py-1 text-[10px] font-bold flex items-center gap-1 opacity-100 transition-opacity"
                      title="Download image"
                    >
                      <i className="fa-solid fa-download"></i>
                    </button>
                  </div>
                ))}
              </div>
            )}
{/* ===== PAYMENT SECTION ===== */}
{visit.moneyReceived !== undefined && visit.moneyReceived !== "" && (
  <div className="border-t border-slate-100 pt-4 mt-4">

    <label className="text-[9px] font-black text-emerald-600 uppercase">
      Payment Details
    </label>

    <div className="mt-2 space-y-1 text-sm font-semibold">
      <p>Amount: ₹{visit.moneyReceived}</p>
      {visit.paymentMode && <p>Mode: {visit.paymentMode}</p>}
      {visit.paymentNotes && <p>Notes: {visit.paymentNotes}</p>}
    </div>

  </div>
)}
            <div className="space-y-6">
              <ReportList title="Main Medicine" list={visit.mainRx} color="text-blue-600" />
              <ReportList title="Supportive" list={visit.supportRx} color="text-slate-600" />
              <ReportList title="SOS" list={visit.sosRx} color="text-red-600" isSos={true} />
            </div>
            {downloadToast && (
              <div className="fixed bottom-8 left-1/2 -translate-x-1/2 z-[500] bg-slate-900 text-white px-5 py-3 rounded-2xl shadow-2xl flex items-center gap-3 text-sm font-bold animate-[fadeDown_0.25s_ease]">
                <i className="fa-solid fa-circle-check text-green-400"></i>
                Image saved successfully!
              </div>
            )}
            {previewImage && (
              <div className="fixed inset-0 z-[400] flex items-center justify-center bg-black/80 backdrop-blur-md">

                <div className="relative w-[95vw] max-w-[500px]">

                  <button
                    onClick={() => setPreviewImage(null)}
                    className="absolute top-4 right-4 bg-white text-black px-4 py-2 rounded-xl font-bold text-xs z-50 shadow-lg"
                  >
                    Cancel
                  </button>

                  <img
                    src={previewImage}
                    className="w-full max-h-[85vh] object-contain rounded-2xl shadow-2xl"
                  />
                </div>
              </div>
            )}

          </div>
        );
      });


      const ReportList = ({ title, list, color, isSos }) => (
        list[0]?.name ? (
          <div className="space-y-2">
            <label className={`text-[10px] font-black ${color} uppercase tracking-widest`}>{title}</label>
            {list.map((rx, i) => (
              <div key={i} className="p-4 bg-slate-50 border border-slate-100 rounded-2xl">
                <div className="flex justify-between font-bold text-sm"><span>{rx.name}</span><span className={color}>{rx.dose}</span></div>
                {isSos && rx.remarks && <p className="text-[10px] text-red-500 mt-2 font-semibold">IF: {rx.remarks}</p>}
              </div>
            ))}
          </div>
        ) : null
      );
