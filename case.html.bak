    const Home = React.memo(({
      db,
      search,
      setSearch,
      setActivePatientId,
      setView,
      regModal,
      setRegModal,
      clinic,
      setClinic,
      setDb,
      loadingPatients
    }) => {

const [menuOpen, setMenuOpen] = React.useState(false);
const [sortOrder, setSortOrder] = React.useState('high-low');

      const filteredPatients = useMemo(() => {
        const term = search.toLowerCase();

        return db.patients
          .filter(p =>
            p.name?.toLowerCase().includes(term) ||
            p.regNo?.toString().toLowerCase().includes(term) ||
            p.phone?.toString().toLowerCase().includes(term)
          )
.sort((a, b) =>
            sortOrder === 'high-low'
              ? Number(b.regNo || 0) - Number(a.regNo || 0)
              : Number(a.regNo || 0) - Number(b.regNo || 0)
          );
      }, [db.patients, search, sortOrder]);

      return (
        <>
          {/* Animated Content Only */}
          <div>

            {/* FIXED HEADER - REDESIGNED FOR BREATHING ROOM */}
            <div className="sticky top-0 z-40 saas-header px-6 md:px-12 lg:px-16 pt-8 pb-4"
>

