  <script>
    // Safe fallback for web view if capacitor.js is absent
    window.addEventListener('error', function(e) {
      if (e.target && e.target.src && e.target.src.includes('capacitor.js')) {
        e.preventDefault();
      }
    }, true);
  </script>
  <script src="capacitor.js" onerror="console.log('Running in browser PWA mode')"></script>


