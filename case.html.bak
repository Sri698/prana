            };
          })
        }));

        await deleteVisitRTDB(patient.id, deleteId);
      }
    });
  }}
  className="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-red-100"
>
  <i className="fa-solid fa-trash text-red-400 text-[11px]"></i>
</button>


                    </div>

                  </div>
