      };

const Consultation = () => {
  if (!patient) return null;

  // ✅ CRITICAL FIX — prevent blank screen while visit loads
  if (activeVisitId && !visit) {
    return (
      <div className="flex items-center justify-center h-screen">
        <p className="font-bold text-slate-400">
          Loading consultation...
        </p>
      </div>
    );
  }

       const defaultForm = {
  date: new Date().toISOString().split("T")[0],
  complaints: [''],
  familyHistory: '',
  anxiety: '',
  fear: '',
  irritability: '',
  company: '',
  contradiction: '',
  thermal: '',
  thirst: '',
  thirstPattern: '',
  appetite: '',
  cravings: '',
  aversions: '',
  sweat: '',
  sleepQuality: '',
  sleepPosition: '',
  timeAggravation: '',
  mindRubrics: [],
  generalRubrics: [],
  remarks: '',
  moneyReceived: "",
  paymentMode: "",
  paymentNotes: "",
  mainRx: [{ name: '', dose: '' }],
  supportRx: [{ name: '', dose: '' }],
  sosRx: [{ name: '', dose: '', remarks: '' }]
};

const [form, setForm] = useState(defaultForm);


        const [images, setImages] = useState([]);
        const [showImageOptions, setShowImageOptions] = useState(false);
        const [previewImage, setPreviewImage] = useState(null);
        
        const [showCalendar, setShowCalendar] = useState(false);
        const [currentMonth, setCurrentMonth] = useState(new Date());

        useEffect(() => {
          if (!visit) {
            setImages([]);
            return;
          }

        setForm({
 ...visit,
  moneyReceived: visit.moneyReceived || "",
  paymentMode: visit.paymentMode || "",
  paymentNotes: visit.paymentNotes || "",
  anxiety: visit.anxiety || '',
  fear: visit.fear || '',
  irritability: visit.irritability || '',
  company: visit.company || '',
  contradiction: visit.contradiction || '',
  mindRubrics: visit.mindRubrics || [],
  generalRubrics: visit.generalRubrics || [],

  complaints: visit.complaints
    ? visit.complaints
    : visit.complaint
      ? [visit.complaint]
      : ['']
});



          if (Array.isArray(visit.images)) {
            setImages(
              visit.images.map(url => ({
                preview: url,
                isRemote: true
              }))
            );
          } else {
            setImages([]);
          }
        }, [visit]);



        // stores webp blobs + preview
        const addRx = (type) => setForm({ ...form, [type]: [...form[type], { name: '', dose: '', ...(type === 'sosRx' ? { remarks: '' } : {}) }] });
        const updateRx = (type, idx, field, val) => {
          const newList = [...form[type]];
          newList[idx][field] = val;
          setForm({ ...form, [type]: newList });
        };
        const removeRx = (type, idx) => setForm({ ...form, [type]: form[type].filter((_, i) => i !== idx) });
        const convertToWebP = (file, quality = 0.7, maxWidth = 1280) => {
          return new Promise((resolve) => {
            const img = new Image();
            const reader = new FileReader();

            reader.onload = () => (img.src = reader.result);
            reader.readAsDataURL(file);

            img.onload = () => {
              const scale = Math.min(1, maxWidth / img.width);
              const canvas = document.createElement("canvas");

              canvas.width = img.width * scale;
              canvas.height = img.height * scale;

              const ctx = canvas.getContext("2d");
              ctx.drawImage(img, 0, 0, canvas.width, canvas.height);

              canvas.toBlob(
                (blob) => resolve(blob),
                "image/webp",
                quality
              );
            };
          });
        };
const handleImageCapture = async (e) => {
  const files = Array.from(e.target.files);
  if (!files.length) return;

  for (const file of files) {
    const webpBlob = await convertToWebP(file, 0.6);
    const previewUrl = URL.createObjectURL(webpBlob);

    setImages(prev => [
      ...prev,
      {
        blob: webpBlob,
        preview: previewUrl,
        name: `case_${Date.now()}_${Math.random()}.webp`
      }
    ]);
  }

  e.target.value = "";
};
        const [savingVisit, setSavingVisit] = useState(false);

        const saveVisit = async () => {
          if (savingVisit || !clinic) return;

          setSavingVisit(true);

          const visitId = visit?.id || ('v_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6));

          const existingUrls = images.filter(i => i.isRemote).map(i => i.preview);
          const newImages = images.filter(i => !i.isRemote);

          const uploadedUrls = await uploadImagesToSupabase(
            clinic,
            activePatientId,
            visitId,
            newImages
          );

          const imageUrls = [...existingUrls, ...uploadedUrls];

          const { complaint, ...cleanForm } = form;

          const newVisitData = {
            ...cleanForm,
            id: visitId,
            images: imageUrls,
            createdAt: Date.now()
          };

          // 1. Sync to MySQL API
          try {
            await fetch(`${API_BASE}/visits.php`, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                ...newVisitData,
                patientId: activePatientId,
                clinic: clinic
              })
            });
          } catch (e) {
            console.warn("MySQL visit sync notice:", e);
          }

          // 2. Immediately update local state & encrypted cache
          setDb(prev => {
            const updatedPatients = (prev.patients || []).map(p => {
              if (p.id !== activePatientId) return p;
              const curHistory = p.history || [];
              const exists = curHistory.findIndex(v => v.id === visitId);
              let newHist;
              if (exists >= 0) {
                newHist = [...curHistory];
                newHist[exists] = newVisitData;
              } else {
                newHist = [newVisitData, ...curHistory];
              }
              return { ...p, history: newHist };
            });
            try {
              const enc = CryptoJS.AES.encrypt(JSON.stringify(updatedPatients), SECRET_KEY).toString();
              // localStorage.setItem(`prana_patients_${clinic}`, enc);
            } catch(e) {}
            return { ...prev, patients: updatedPatients };
          });

          // 3. Immediately re-fetch updated visits from MySQL
          try {
            const vRes = await fetch(`${API_BASE}/visits.php?patient_id=${encodeURIComponent(activePatientId)}`);
            if (vRes.ok) {
              const vData = await vRes.json();
              if (vData?.status === 'success' && Array.isArray(vData.data)) {
                setDb(prev => ({
                  ...prev,
                  patients: (prev.patients || []).map(p =>
                    p.id === activePatientId ? { ...p, history: vData.data } : p
                  )
                }));
              }
            }
          } catch(e) {}

          // 4. Navigate back to timeline
          setActiveVisitId(null);
          setView("TIMELINE");

          // 5. Write to RTDB if connected
          if (rtdb) {
            try {
              await rtdb
                .ref(`clinics/${clinic}/patients/${activePatientId}/visits/${visitId}`)
                .set(newVisitData);
            } catch(e) {}
          }

          setSavingVisit(false);
        };



        return (
          <div className="bg-white min-h-screen pb-24 max-w-4xl mx-auto md:shadow-lg md:rounded-2xl md:mt-8 md:p-6">



            <header className="sticky top-0 z-50 bg-white/90 backdrop-blur-md 
px-5 pb-2.5 pt-[calc(env(safe-area-inset-top)+10px)] 
border-b border-slate-100 flex justify-between items-center">
              <button
                onClick={() => setView('TIMELINE')}
                className="text-slate-400 font-bold text-xs uppercase"
              >
                Back
              </button>

              <h2 className="font-black text-slate-900 text-sm tracking-tighter">
                CASE ANALYSIS
              </h2>

              <div className="flex gap-3">
                {/* DELETE VISIT */}
                {visit && (
                  <button
                    onClick={async () => {
                      setConfirmModal({
                        show: true,
                        title: "Delete Consultation",
                        message: "This action cannot be undone. Delete permanently?",
                        onConfirm: async () => {
                          const visitIdToDelete = visit.id;

                          // 1️⃣ Optimistically remove from local state FIRST
                          setDb(prev => ({
                            ...prev,
                            patients: prev.patients.map(p => {
                              if (p.id !== activePatientId) return p;

                              return {
                                ...p,
                                history: (p.history || []).filter(v => v.id !== visitIdToDelete)
                              };
                            })
                          }));

                          // 2️⃣ Immediately go back
                          setActiveVisitId(null);
                          setView("TIMELINE");

                          // 3️⃣ Then delete from Firebase in background
                          await deleteVisitRTDB(activePatientId, visitIdToDelete);
                        }

                      });

                    }}
                    className="text-red-500 font-black text-xs uppercase"
                  >
                    Delete
                  </button>
                )}

                <button
                  onClick={saveVisit}
                  disabled={savingVisit}
                  className={`bg-blue-600 text-white px-5 py-1.5 rounded-lg font-black text-xs uppercase ${savingVisit ? "opacity-60 pointer-events-none" : ""
                    }`}
                >
                  {savingVisit ? "Saving..." : "Save"}
                </button>


              </div>
            </header>
            <div className="p-5 space-y-8">
              <div>
                <label className="text-[10px] font-black text-slate-400 uppercase mb-2">
                  Consultation Date
                </label>

                <input
                  readOnly
                  value={form.date}
                  onClick={() => setShowCalendar(true)}
                  placeholder="Select Date"
                  className="input-field cursor-pointer"
                />
              </div>


              <section className="space-y-4">
                <div>
                  <label className="text-[10px] font-black text-slate-400 uppercase tracking-widest block mb-2">
                    Patient Complaints
                  </label>

                  <div className="space-y-3">
                    {(form.complaints || []).map((c, i) => (
                      <div key={i} className="flex gap-2 items-start">
                        <textarea
                          className="input-field min-h-[80px]"
                          value={c}
                          placeholder="Enter complaint..."
                          onChange={(e) => {
                            const updated = [...form.complaints];
                            updated[i] = e.target.value;
                            setForm({ ...form, complaints: updated });
                          }}
                        />

                        <button
                          onClick={() => {
                            const updated = form.complaints.filter((_, idx) => idx !== i);
                            setForm({ ...form, complaints: updated.length ? updated : [''] });
                          }}
                          className="text-red-400 text-xs mt-2"
                        >
                          <i className="fa-solid fa-xmark"></i>
                        </button>
                      </div>
                    ))}

                    <button
                      onClick={() =>
                        setForm({ ...form, complaints: [...form.complaints, ''] })
                      }
                      className="text-blue-600 text-xs font-bold uppercase"
                    >
                      + Add Complaint
                    </button>
                  </div>
                </div>
