  <script type="text/babel">

    // ================= PRANA MYSQL & REST API CLIENT =================
    const API_BASE = './api';
    let isMySqlAvailable = false;

    // Check MySQL API Health on load
    const checkMySqlHealth = async () => {
      try {
        const res = await fetch(`${API_BASE}/health.php`, { cache: 'no-store' });
        if (res.ok) {
          const data = await res.json();
          if (data && data.status === 'healthy') {
            isMySqlAvailable = true;
            return data;
          }
        }
      } catch (e) {
        // Running locally or offline
        isMySqlAvailable = false;
      }
      return null;
    };

    // ================= DYNAMIC PRANA CLOUD CONFIG =================
    // Isolates Prana database completely from any other clinical system
    const getActiveConfig = () => {
      try {
        const stored = null;
        if (stored) return JSON.parse(stored);
      } catch (e) {}
      return window.PRANA_CONFIG || {
        firebase: {
          apiKey: "AIzaSyBgaNGeyKLkZ3OX8TEOlkXjPAUwL9oKJWM",
          authDomain: "fir-clinical.firebaseapp.com",
          databaseURL: "https://fir-clinical-default-rtdb.firebaseio.com",
          projectId: "fir-clinical",
          storageBucket: "fir-clinical.firebasestorage.app",
          messagingSenderId: "432015586131",
          appId: "1:432015586131:web:cc91dc535e9a6d081b67a6"
        },
        supabase: {
          url: "https://your-prana-project.supabase.co",
          anonKey: "YOUR_PRANA_SUPABASE_ANON_KEY",
          bucket: "clinical-images"
        }
      };
    };

    const ACTIVE_CONFIG = getActiveConfig();
    const firebaseConfig = ACTIVE_CONFIG.firebase;

    // Initialize Firebase
    let auth = null;
    let rtdb = null;
    let firebaseAvailable = false;

    try {
      if (firebase.apps.length === 0) {
        firebase.initializeApp(firebaseConfig);
      }
      auth = firebase.auth();
      auth.setPersistence(firebase.auth.Auth.Persistence.LOCAL);
      rtdb = firebase.database();
      firebaseAvailable = true;
    } catch (fbErr) {
      console.warn("Firebase initialization notice:", fbErr.message);
    }

    // Initialize Supabase Storage
    const SUPABASE_URL = ACTIVE_CONFIG.supabase?.url || "";
    const SUPABASE_ANON_KEY = ACTIVE_CONFIG.supabase?.anonKey || "";
    let supabase = null;
    try {
      if (SUPABASE_URL && !SUPABASE_URL.includes("your-prana-project") && window.supabase) {
        supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      }
    } catch (sbErr) {
      console.warn("Supabase initialization notice:", sbErr.message);
    }
    const uploadImagesToSupabase = async (clinic, patientId, visitId, images) => {
      const urls = [];
      const bucketName = ACTIVE_CONFIG.supabase?.bucket || "clinical-images";

      for (const img of images) {
        let uploaded = false;

        // 1. Try PHP MySQL server upload (Direct cPanel storage)
        try {
          const fd = new FormData();
          fd.append('file', img.blob, img.name);
          fd.append('patientId', patientId);
          fd.append('visitId', visitId);

          const res = await fetch(`${API_BASE}/upload.php`, {
            method: 'POST',
            body: fd
          });

          if (res.ok) {
            const data = await res.json();
            if (data && data.status === 'success' && data.url) {
              urls.push(data.url);
              uploaded = true;
            }
          }
        } catch (phpErr) {
          console.warn("PHP upload notice, trying cloud/local fallback:", phpErr);
        }

        if (uploaded) continue;

        // 2. Try Supabase Storage if configured
        if (supabase && SUPABASE_URL && !SUPABASE_URL.includes("your-prana-project")) {
          try {
            const filePath = `clinics/${clinic}/patients/${patientId}/visits/${visitId}/${Date.now()}_${img.name}`;
            const { error } = await supabase.storage
              .from(bucketName)
              .upload(filePath, img.blob, {
                contentType: "image/webp",
                upsert: true
              });

            if (!error) {
              const { data } = supabase.storage.from(bucketName).getPublicUrl(filePath);
              if (data && data.publicUrl) {
                urls.push(data.publicUrl);
                continue;
              }
            } else {
              console.warn("Supabase upload returned error, using local fallback:", error);
            }
          } catch (e) {
            console.warn("Supabase error during upload, falling back:", e);
          }
        }

        // 3. Safe Fallback: Convert Blob to Data URL so photo is never lost!
        try {
          const reader = new FileReader();
          const dataUrl = await new Promise((resolve) => {
            reader.onloadend = () => resolve(reader.result);
            reader.readAsDataURL(img.blob);
          });
          urls.push(dataUrl);
        } catch (readErr) {
          console.error("Failed to read image locally:", readErr);
        }
      }

      return urls;
    };


    const { useState, useEffect, useMemo } = React;
