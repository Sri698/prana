// ================= PREMIUM PRESCRIPTION MODULE =================
const Prescription = () => {

  const STORAGE_KEY = "prana_prescriptions_v1";

  const emptyForm = {
    id: null,
    patientName: "",
    age: "",
    date: new Date().toISOString().split("T")[0],
    medicines: [{ name: "", potency: "", dose: "" }]
  };

  const [form, setForm] = React.useState(emptyForm);
  const [records, setRecords] = React.useState([]);
  const [selectedId, setSelectedId] = React.useState(null);

  // ===== Load Saved Prescriptions from MySQL + Local =====
  React.useEffect(() => {
    const loadPrescriptions = async () => {
      try {
        const res = await fetch(`${API_BASE}/prescriptions.php?clinic=${encodeURIComponent(clinic || 'KATTUPAKKAM')}`);
        if (res.ok) {
          const json = await res.json();
          if (json && json.status === 'success' && Array.isArray(json.data)) {
            setRecords(json.data);
            // localStorage.setItem(STORAGE_KEY, JSON.stringify(json.data));
            return;
          }
        }
      } catch(e) {}
      const saved = JSON.parse(null || "[]");
      setRecords(saved);
    };
    loadPrescriptions();
  }, [clinic]);

  const persist = (data) => {
    // localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
    setRecords(data);
  };

  // ===== CRUD =====
  const handleNew = () => {
    setForm(emptyForm);
    setSelectedId(null);
  };

  const handleSave = async () => {
    if (!form.patientName) return alert("Enter patient name");

    const recordId = form.id || ('rx_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6));
    const fullRx = {
      ...form,
      id: recordId,
      clinic: clinic || 'KATTUPAKKAM',
      branch: clinic || 'KATTUPAKKAM'
    };

    let updated;
    if (form.id) {
      updated = records.map(r => r.id === form.id ? fullRx : r);
    } else {
      updated = [fullRx, ...records];
    }

    setForm(fullRx);
    setSelectedId(recordId);
    persist(updated);

    // Persist to MySQL Backend
    try {
      await fetch(`${API_BASE}/prescriptions.php`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(fullRx)
      });
    } catch (e) {
      console.warn("Backend prescription save notice:", e);
    }

    alert("Prescription Saved Successfully!");
  };

  const handleDelete = async () => {
    if (!selectedId) return;
    if (!confirm("Are you sure you want to delete this prescription?")) return;
    const updated = records.filter(r => r.id !== selectedId);
    persist(updated);
    try {
      await fetch(`${API_BASE}/prescriptions.php?id=${encodeURIComponent(selectedId)}`, { method: 'DELETE' });
    } catch(e) {}
    handleNew();
  };

  const selectRecord = (rec) => {
    setForm(rec);
    setSelectedId(rec.id);
  };

  // ===== Medicine Logic =====
  const addMedicine = () => {
    setForm({
      ...form,
      medicines: [...form.medicines, { name: "", potency: "", dose: "" }]
    });
  };

  const updateMed = (index, field, value) => {
    const copy = [...form.medicines];
    copy[index][field] = value;
    setForm({ ...form, medicines: copy });
  };

  const removeMed = (index) => {
    setForm({
      ...form,
      medicines: form.medicines.filter((_, i) => i !== index)
    });
  };
const exportPDF = () => {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();

  const W = 210;
  const H = 297;
  const M = 18;

  let y;

  const img = new Image();
  img.src = "assets/prana_brand_logo.png";

  const renderPrescriptionContent = (hasImg) => {
    const headerTop = 20;
    const logoSize = 18;

    if (hasImg) {
      try {
        doc.addImage(img, "PNG", M, headerTop, 24, 18);
      } catch (e) {}
    }

    const titleLeft = hasImg ? M + 28 : M;

    // Clinic Title
    doc.setFont("helvetica", "bold");
    doc.setFontSize(17);
    doc.setTextColor(7, 59, 66);
    doc.text("PRANA HOMEO CARE", titleLeft, headerTop + 7);

    doc.setFont("helvetica", "italic");
    doc.setFontSize(8.5);
    doc.setTextColor(181, 141, 55);
    doc.text("DOOR OF HOPE — Holistic & Paediatric Healing", titleLeft, headerTop + 13);

    // Doctor block
    doc.setFont("helvetica", "bold");
    doc.setFontSize(9.5);
    doc.setTextColor(15, 23, 42);
    const rightX = W - M;

    doc.text("Dr. G. Srinivasan, M.D.(Hom)", rightX, headerTop + 4, { align: "right" });
    doc.setFont("helvetica", "normal");
    doc.setFontSize(8);
    doc.setTextColor(70, 101, 106);
    doc.text("Consultant Homoeopathic Paediatrician", rightX, headerTop + 9, { align: "right" });
    doc.text("Ph: +91 98842 23007 / 98843 46007", rightX, headerTop + 14, { align: "right" });
    doc.text("Kattupakkam, Chennai - 600056", rightX, headerTop + 18, { align: "right" });

    // Divider
    doc.setDrawColor(201, 162, 74);
    doc.setLineWidth(0.8);
    doc.line(M, headerTop + 24, W - M, headerTop + 24);

    // =========================
    // PATIENT ROW (TIGHT + CLEAN)
    // =========================

    y = headerTop + 36;

    doc.setFont("helvetica", "bold");
    doc.setFontSize(11);

    doc.text("Patient Name:", M, y);
    doc.setFont("helvetica", "normal");
    doc.text(form.patientName || "__________", M + 34, y);

    doc.setFont("helvetica", "bold");
    doc.text("Age:", 125, y);
    doc.setFont("helvetica", "normal");
    doc.text(form.age || "__", 138, y);

    doc.setFont("helvetica", "bold");
    doc.text("Date:", 155, y);
    doc.setFont("helvetica", "normal");
    doc.text(form.date || "", 170, y);

    // Thin line right under it
    doc.setLineWidth(0.6);
    doc.line(M, y + 6, W - M, y + 6);

    // =========================
    // RX SECTION
    // =========================

    y += 18;

    doc.setFont("helvetica", "bold");
    doc.setFontSize(15);
    doc.text("Rx", M, y);

    y += 12;

    doc.setFontSize(11);
    doc.text("Medicine", M, y);
    doc.text("Potency", 135, y);
    doc.text("Dose (M-A-N)", W - M, y, { align: "right" });

    doc.line(M, y + 4, W - M, y + 4);

    y += 12;

    doc.setFont("helvetica", "normal");
    doc.setFontSize(12);

    form.medicines.forEach((m, i) => {
      doc.text(`${i + 1}. ${m.name || "-"}`, M, y);
      doc.text(m.potency || "-", 135, y);
      doc.text(m.dose || "3-0-3", W - M, y, { align: "right" });
      y += 12;
    });

    // =========================
    // SIGNATURE (BALANCED)
    // =========================

    y = H - 40;

    doc.line(W - 70, y, W - M, y);
    doc.setFontSize(9);
    doc.text("Doctor Signature", W - 70, y + 5);

    doc.save(`${form.patientName || "Prescription"}.pdf`);
  };

  img.onload = function() { renderPrescriptionContent(true); };
  img.onerror = function() { renderPrescriptionContent(false); };
};

  return (
    <div className="flex h-full">

      {/* LEFT LIST PANEL */}
      <div className="w-72 border-r bg-white hidden md:block p-6 space-y-4">

        <div className="flex justify-between items-center">
          <h3 className="font-black text-lg">Records</h3>
          <button onClick={handleNew} className="text-blue-600 font-bold text-xs">
            + New
          </button>
        </div>

        <div className="space-y-2 overflow-y-auto max-h-[80vh]">
          {records.map(rec => (
            <div
              key={rec.id}
              onClick={()=>selectRecord(rec)}
              className={`p-3 rounded-xl cursor-pointer border ${
                rec.id===selectedId ? "bg-blue-50 border-blue-200" : "hover:bg-slate-50"
              }`}
            >
              <p className="font-bold text-sm">{rec.patientName}</p>
              <p className="text-xs text-slate-400">{rec.date}</p>
            </div>
          ))}
        </div>

      </div>

      {/* RIGHT FORM PANEL */}
      <div className="flex-1 p-12 space-y-8">

        {/* HEADER BAR */}
        <div className="flex justify-between items-center">
          <h2 className="text-2xl font-black">Prescription</h2>

          <div className="flex gap-3">
            <button onClick={handleDelete}
              className="px-4 py-2 text-xs font-bold rounded-xl bg-red-100 text-red-600">
              Delete
            </button>
            <button onClick={handleSave}
              className="px-4 py-2 text-xs font-bold rounded-xl bg-slate-900 text-white">
              Save
            </button>
            <button onClick={exportPDF}
              className="px-4 py-2 text-xs font-bold rounded-xl bg-blue-600 text-white">
              Export PDF
            </button>
          </div>
        </div>

        {/* PATIENT INFO & LINKING */}
        <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
          <div>
            <select
              className="input-field w-full text-xs font-semibold bg-slate-50 border border-slate-200"
              onChange={e => {
                const selectedPatient = (db.patients || []).find(p => p.id === e.target.value);
                if (selectedPatient) {
                  setForm(prev => ({
                    ...prev,
                    patientId: selectedPatient.id,
                    patientName: selectedPatient.name,
                    age: selectedPatient.age || '',
                    gender: selectedPatient.gender || 'M'
                  }));
                }
              }}
              defaultValue=""
            >
              <option value="">-- Link Registered Patient --</option>
              {(db.patients || []).map(p => (
                <option key={p.id} value={p.id}>
                  #{p.regNo} - {p.name} ({p.phone || p.age + 'Y'})
                </option>
              ))}
            </select>
          </div>
          <input className="input-field" placeholder="Patient Name *"
            value={form.patientName}
            onChange={e=>setForm({...form,patientName:e.target.value})}/>
          <input className="input-field" placeholder="Age"
            value={form.age}
            onChange={e=>setForm({...form,age:e.target.value})}/>
          <input type="date" className="input-field"
            value={form.date}
            onChange={e=>setForm({...form,date:e.target.value})}/>
        </div>

        {/* MEDICINES */}
        <div className="space-y-4">
          {form.medicines.map((m,i)=>(
            <div key={i} className="grid grid-cols-4 gap-6 items-center">

              <input className="input-field col-span-2"
                placeholder="Medicine Name"
                value={m.name}
                onChange={e=>updateMed(i,"name",e.target.value)} />

              <input className="input-field"
                placeholder="Potency"
                value={m.potency}
                onChange={e=>updateMed(i,"potency",e.target.value)} />

              <input className="input-field font-bold text-blue-600"
                placeholder="3-0-3"
                value={m.dose}
                onChange={e=>updateMed(i,"dose",e.target.value)} />

              {i>0 &&
                <button onClick={()=>removeMed(i)}
                  className="col-span-4 text-red-500 text-xs font-bold text-left">
                  Remove
                </button>}
            </div>
          ))}

          <button onClick={addMedicine}
            className="bg-blue-600 text-white px-6 py-3 rounded-xl font-bold">
            + Add Medicine
          </button>
        </div>

      </div>
    </div>
  );
};
// ================= PHARMACY MODAL =================
const PharmacyModal = () => {
const initialData = pharmacyModal.editData || {
  name: "",
  potency: "",
  form: "Globules",
  quantity: "",
  minStock: "",
  expiry: "",
  supplier: "",
  notes: ""
};

  const [f, setF] = useState(initialData);

  return (
    <div className="fixed inset-0 z-[500] flex items-center justify-center px-4">
      <div
        className="absolute inset-0 bg-black/50 backdrop-blur-sm"
        onClick={() => setPharmacyModal({ show: false, editData: null })}
      ></div>

      <div className="relative w-full max-w-[420px] bg-white rounded-2xl p-8 space-y-4 shadow-2xl">

        <h3 className="text-lg font-black">
          {pharmacyModal.editData ? "Edit Medicine" : "Add Medicine"}
        </h3>

        <input
          className="input-field"
          placeholder="Medicine Name"
          value={f.name}
          onChange={e => setF({ ...f, name: e.target.value })}
        />

        <input
          className="input-field"
          placeholder="Potency (30C, 200C)"
          value={f.potency}
          onChange={e => setF({ ...f, potency: e.target.value })}
        />


        <div>
  <label className="text-[10px] font-bold text-slate-500 uppercase block mb-1">
    Current Quantity (No. of bottles)
  </label>
  <input
    className="input-field"
    type="number"
    placeholder="Enter available stock"
    value={f.quantity}
    onChange={e => setF({ ...f, quantity: e.target.value })}
  />
</div>


<div>
  <label className="text-[10px] font-bold text-slate-500 uppercase block mb-1">
    Minimum Stock Alert Level
  </label>
  <input
    className="input-field"
    type="number"
    placeholder="Alert when below this number"
    value={f.minStock}
    onChange={e => setF({ ...f, minStock: e.target.value })}
  />
</div>


        <div className="flex gap-3 pt-4">
          <button
            onClick={() => setPharmacyModal({ show: false, editData: null })}
            className="flex-1 border border-slate-200 rounded-xl h-11 font-bold text-xs"
          >
            Cancel
          </button>

          <button
            onClick={() => saveMedicine(f)}
            className="flex-1 bg-blue-600 text-white rounded-xl h-11 font-black text-xs"
          >
            Save
          </button>
        </div>

      </div>
    </div>
  );
};

      const RegistrationModal = () => {
        const nextRegNo = !regModal.editData
  ? String(Math.max(0, ...db.patients.map(p => Number(p.regNo) || 0)) + 1)
  : regModal.editData.regNo;

const initialDataRef = React.useRef(
  regModal.editData || {
    name: '',
    regNo: nextRegNo,
    gender: 'M',
            age: '',
            weight: '',
            phone: '',
            address: '',
            registeredDate: new Date().toISOString().split("T")[0]
          }
        );

        const [f, setF] = useState(initialDataRef.current);

        const [showRegCalendar, setShowRegCalendar] = useState(false);

        return (
          <>
            <div className="fixed inset-0 z-[100] flex items-end justify-center px-4">
              <div
                className="absolute inset-0 bg-slate-900/60 backdrop-blur-sm"
                onClick={() => !savingPatient && setRegModal({ show: false, editData: null })}
              ></div>
              <div className="w-full max-w-[440px] bg-white rounded-t-[32px] p-8 pb-10 relative shadow-2xl">

                <div className="w-10 h-1 bg-slate-100 rounded-full mx-auto mb-6"></div>
                <div className="space-y-4">
                  <div className="flex gap-3">
                    <div className="w-1/3"><label className="text-[10px] font-black text-slate-400 uppercase mb-1 block">Reg ID</label><input className="input-field" value={f.regNo} onChange={e => setF({ ...f, regNo: e.target.value })} /></div>
                    <div className="w-2/3"><label className="text-[10px] font-black text-slate-400 uppercase mb-1 block">Name</label><input className="input-field" value={f.name} onChange={e => setF({ ...f, name: e.target.value })} /></div>
                  </div>
                  <div className="grid grid-cols-3 gap-3">
                    <div><label className="text-[10px] font-black text-slate-400 uppercase mb-1 block">Age</label><input className="input-field" type="number" value={f.age} onChange={e => setF({ ...f, age: e.target.value })} /></div>
                    <div><label className="text-[10px] font-black text-slate-400 uppercase mb-1 block">Weight</label><input className="input-field" type="number" value={f.weight} onChange={e => setF({ ...f, weight: e.target.value })} /></div>
                    <div>
                      <label className="text-[10px] font-black text-slate-400 uppercase mb-1 block">Gender</label>
                      <div className="gender-toggle">
                        <div
                          onClick={() => setF({ ...f, gender: 'M' })}
                          className={`gender-option ${f.gender === 'M' ? 'active shadow-sm' : ''}`}
                        >
                          M
                        </div>
                        <div
                          onClick={() => setF({ ...f, gender: 'F' })}
                          className={`gender-option ${f.gender === 'F' ? 'active shadow-sm' : ''}`}
                        >
                          F
                        </div>
                      </div>
                    </div>
                  </div>
                  <div><label className="text-[10px] font-black text-slate-400 uppercase mb-1 block">Phone</label><input className="input-field" type="tel" value={f.phone} onChange={e => setF({ ...f, phone: e.target.value })} /></div>
                  <div><label className="text-[10px] font-black text-slate-400 uppercase mb-1 block">Address</label><textarea className="input-field h-16" value={f.address} onChange={e => setF({ ...f, address: e.target.value })}></textarea>
                  </div>

                  <div>
                    <label className="text-[10px] font-black text-slate-400 uppercase mb-1 block">
                      Registration Date
                    </label>
                    <input
                      readOnly
                      value={f.registeredDate}
                      onClick={() => setShowRegCalendar(true)}
                      className="input-field cursor-pointer"
                    />

                  </div>

                  <button
                    disabled={savingPatient}

                    onClick={() => savePatient(f)}
                    className={`btn-primary mt-4 uppercase text-xs tracking-widest ${savingPatient ? 'opacity-60 pointer-events-none' : ''
                      }`}
                  >
                    {savingPatient ? 'Saving…' : 'Register Patient'}
                  </button>

                </div>
              </div>
            </div>
            {showRegCalendar && (
              <CustomCalendar
                value={f.registeredDate}
                onChange={(date) => setF({ ...f, registeredDate: date })}
                onClose={() => setShowRegCalendar(false)}
              />
            )}
          </>
        );
      };
      const CustomCalendar = ({ value, onChange, onClose }) => {
        const [current, setCurrent] = useState(
          value ? new Date(value) : new Date()
        );

        const year = current.getFullYear();
        const month = current.getMonth();

        const firstDayIndex = new Date(year, month, 1).getDay();
        const daysInMonth = new Date(year, month + 1, 0).getDate();

        const weekdays = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];

        const generateDays = () => {
          const days = [];

          for (let i = 0; i < firstDayIndex; i++) {
            days.push(null);
          }

          for (let d = 1; d <= daysInMonth; d++) {
            days.push(d);
          }

          return days;
        };

        const formatted = (d) =>
          `${year}-${String(month + 1).padStart(2, "0")}-${String(d).padStart(2, "0")}`;

        return (
          <div className="fixed inset-0 z-[600] flex items-center justify-center bg-black/40 backdrop-blur-sm">
            <div className="bg-white w-[95%] max-w-[400px] rounded-3xl p-6 shadow-2xl">

              {/* Header */}
              <div className="flex justify-between items-center mb-4">
                <button
                  onClick={() => setCurrent(new Date(year - 1, month))}
                  className="text-sm font-bold"
                >
                  «
                </button>

                <button
                  onClick={() => setCurrent(new Date(year, month - 1))}
                  className="text-sm font-bold"
                >
                  ‹
                </button>

                <h3 className="font-black text-sm">
                  {current.toLocaleString("default", { month: "long" })} {year}
                </h3>

                <button
                  onClick={() => setCurrent(new Date(year, month + 1))}
                  className="text-sm font-bold"
                >
                  ›
                </button>

                <button
                  onClick={() => setCurrent(new Date(year + 1, month))}
                  className="text-sm font-bold"
                >
                  »
                </button>
              </div>

              {/* Weekdays */}
              <div className="grid grid-cols-7 text-center text-xs font-bold text-slate-400 mb-2">
                {weekdays.map((w) => (
                  <div key={w}>{w}</div>
                ))}
              </div>

              {/* Dates */}
              <div className="grid grid-cols-7 gap-2 text-center text-sm">
                {generateDays().map((d, i) =>
                  d ? (
                    <div
                      key={i}
                      onClick={() => {
                        onChange(formatted(d));
                        onClose();
                      }}
                      className={`p-2 rounded-xl cursor-pointer transition ${value === formatted(d)
                          ? "bg-blue-600 text-white font-bold"
                          : "hover:bg-blue-100"
                        }`}
                    >
                      {d}
                    </div>
                  ) : (
                    <div key={i}></div>
                  )
                )}
              </div>

              <button
                onClick={onClose}
                className="mt-6 w-full py-2 rounded-xl bg-slate-100 font-semibold"
              >
                Close
              </button>
            </div>
          </div>
        );
      };

      const ConfirmModal = () => {
        if (!confirmModal.show) return null;

        return (
          <div className="fixed inset-0 z-[200] flex items-center justify-center px-6">

            <div
              className="absolute inset-0 bg-black/50 backdrop-blur-sm"
              onClick={() => setConfirmModal({ show: false })}
            ></div>

            <div className="relative bg-white w-full max-w-[380px] rounded-3xl p-8 shadow-2xl">


              <h3 className="text-lg font-black text-slate-900 mb-2 tracking-tight">
                {confirmModal.title}
              </h3>

              <p className="text-sm text-slate-500 mb-8 leading-relaxed">
                {confirmModal.message}
              </p>

              <div className="flex gap-4">
                <button
                  onClick={() => setConfirmModal({ show: false })}
                  className="flex-1 h-12 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs uppercase tracking-widest"
                >
                  Cancel
                </button>

                <button
                  onClick={() => {
                    const action = confirmModal.onConfirm;

                    // 1️⃣ Close modal immediately
                    setConfirmModal({ show: false });

                    // 2️⃣ Execute action
                    if (action) {
                      action();
                    }
                  }}
                  className="flex-1 h-12 rounded-xl bg-red-500 text-white font-black text-xs uppercase tracking-widest active:scale-[0.97] transition"
                >
                  Confirm
                </button>

              </div>
            </div>
          </div>
        );
      };

      // ConfigModal removed per doctor portal requirements

      const Login = () => {
        const [email, setEmail] = useState('doctor');
        const [password, setPassword] = useState('password123');
        const [showPassword, setShowPassword] = useState(true);
        const [error, setError] = useState('');
        const [loading, setLoading] = useState(false);

        const handleLogin = async () => {
          setLoading(true);
          setError('');
          const cleanEmail = (email || '').trim().toLowerCase();
          const cleanPass = (password || '').trim();
          
          if ((cleanEmail === 'clinic@email.com' || cleanEmail === 'doctor' || cleanEmail === 'prana' || cleanEmail === 'admin') && 
              (cleanPass === 'password123' || cleanPass === 'prana2026' || cleanPass === 'admin' || cleanPass === 'doctor')) {
            setClinic("KATTUPAKKAM");
            setView("APPOINTMENTS");
            setLoading(false);
          } else {
            setError("Invalid email or password");
            setLoading(false);
          }
        };

        return (
          <div className="fixed inset-0 flex items-center justify-center bg-gradient-to-br from-[#f8fafc] to-[#eef2ff] px-6">
            <div className="w-full max-w-[420px] bg-white rounded-[32px] p-8 md:p-10 shadow-[0_25px_60px_-10px_rgba(0,0,0,0.15)] space-y-6">

              {/* Brand */}
              <div className="text-center space-y-2">
                <div className="w-16 h-16 mx-auto rounded-2xl bg-white p-2 shadow-md border border-slate-100 flex items-center justify-center mb-2">
                  <img src="assets/prana_brand_logo.png" alt="Prana Logo" className="w-full h-full object-contain" />
                </div>
                <h1 className="text-2xl md:text-3xl font-black tracking-tight text-[#073B42]">
                  PRANA HOMEO CARE
                </h1>
                <p className="text-[10px] font-bold text-[#b58d37] tracking-[0.3em] uppercase">
                  Door of Hope · Clinical Portal
                </p>
                <p className="text-[11px] text-slate-500 font-semibold">
                  Dr. G. Srinivasan M.D(Hom)
                </p>
              </div>

              {/* Clinic Login Credentials Badge */}
              <div className="bg-teal-50/90 border border-teal-200 rounded-2xl p-4 text-xs space-y-2">
                <div className="font-bold text-teal-900 flex items-center justify-between">
                  <span className="flex items-center gap-1.5">
                    <i className="fa-solid fa-key text-teal-700"></i> Clinic Login Credentials
                  </span>
                  <span className="text-[10px] uppercase font-black text-teal-800 bg-teal-200/60 px-2 py-0.5 rounded-full">
                    Doctor Access
                  </span>
                </div>
                <div className="space-y-1.5 text-slate-700 font-medium text-[11px]">
                  <div className="flex items-center justify-between">
                    <span className="text-slate-500">Username / Email:</span>
                    <span className="font-mono font-bold text-teal-950 bg-white px-2 py-0.5 rounded border border-teal-200">doctor</span>
                  </div>
                  <div className="flex items-center justify-between">
                    <span className="text-slate-500">Password:</span>
                    <span className="font-mono font-bold text-teal-950 bg-white px-2 py-0.5 rounded border border-teal-200">password123</span>
                  </div>
                </div>
                <button
                  type="button"
                  onClick={() => { setEmail('doctor'); setPassword('password123'); }}
                  className="w-full mt-1 py-1.5 px-3 bg-teal-600 hover:bg-teal-700 text-white rounded-xl font-bold text-[11px] transition flex items-center justify-center gap-1.5 shadow-sm"
                >
                  <i className="fa-solid fa-bolt"></i> Auto-Fill Credentials
                </button>
              </div>

              {/* Inputs */}
              <div className="space-y-3.5">
                <div>
                  <label className="text-[10px] font-black text-slate-400 uppercase tracking-wider block mb-1.5">
                    Username or Email
                  </label>
                  <input
                    className="w-full bg-slate-100 border border-transparent focus:border-teal-500 focus:bg-white rounded-xl py-3 px-4 font-semibold text-sm outline-none transition"
                    placeholder="doctor"
                    value={email}
                    onChange={e => setEmail(e.target.value)}
                  />
                </div>

                <div>
                  <div className="flex items-center justify-between mb-1.5">
                    <label className="text-[10px] font-black text-slate-400 uppercase tracking-wider block">
                      Password
                    </label>
                    <button
                      type="button"
                      onClick={() => setShowPassword(!showPassword)}
                      className="text-[11px] font-bold text-teal-700 hover:text-teal-900 flex items-center gap-1"
                    >
                      <i className={`fa-solid ${showPassword ? 'fa-eye-slash' : 'fa-eye'}`}></i>
                      <span>{showPassword ? 'Hide' : 'Show Letters'}</span>
                    </button>
                  </div>
                  <div className="relative">
                    <input
                      type={showPassword ? "text" : "password"}
                      className="w-full bg-slate-100 border border-transparent focus:border-teal-500 focus:bg-white rounded-xl py-3 px-4 pr-10 font-semibold text-sm outline-none transition"
                      placeholder="password123"
                      value={password}
                      onChange={e => setPassword(e.target.value)}
                    />
                    <button
                      type="button"
                      onClick={() => setShowPassword(!showPassword)}
                      className="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-sm"
                    >
                      <i className={`fa-solid ${showPassword ? 'fa-eye-slash' : 'fa-eye'}`}></i>
                    </button>
                  </div>
                </div>

                {error && (
                  <p className="text-rose-600 text-xs font-bold text-center bg-rose-50 p-2 rounded-lg border border-rose-200">
                    {error}
                  </p>
                )}
              </div>

              {/* Buttons */}
              <div className="space-y-2">
                <button
                  onClick={handleLogin}
                  disabled={loading}
                  className="w-full h-12 rounded-2xl bg-[#073B42] hover:bg-[#0B5C66] text-white font-black text-sm tracking-wide active:scale-[0.97] transition shadow-lg flex items-center justify-center gap-2"
                >
                  <i className="fa-solid fa-arrow-right-to-bracket text-xs"></i>
                  {loading ? "Signing In..." : "Doctor Secure Login"}
                </button>

                <button
                  type="button"
                  onClick={() => {
                    setClinic("KATTUPAKKAM"); setView("APPOINTMENTS");
                  }}
                  className="w-full py-2.5 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold transition flex items-center justify-center gap-2"
                >
                  <i className="fa-solid fa-laptop-medical text-teal-600"></i>
                  <span>1-Click Clinical Direct Access</span>
                </button>
              </div>

            </div>
          </div>
        );
      };

      if (authChecking) return null;
      return (
        <div className="min-h-screen flex bg-gradient-to-br from-slate-50 via-blue-50/40 to-indigo-50/60">


  {/* DESKTOP SIDEBAR */}
  <aside  className="hidden md:flex md:w-72 bg-[#0f172a] text-white flex-col p-8 shadow-2xl"
>

<div className="mb-10 text-center">
    <div className="w-16 h-16 mx-auto mb-3 rounded-2xl bg-white/10 p-2 border border-white/20 backdrop-blur-md flex items-center justify-center">
      <img src="assets/panda_front_cropped.png" alt="Health Buddy Baraka" className="w-full h-full object-contain rounded-xl" />
    </div>
    <h2 className="text-xl font-black tracking-tight text-white">
      PRANA HOMEO CARE
    </h2>
    <p className="text-[10px] font-bold text-[#d4af37] tracking-widest uppercase mt-0.5">
      Door of Hope
    </p>
    <p className="text-[9px] text-slate-400 mt-1">
      Dr. G. Srinivasan M.D(Hom)
    </p>
  </div>


    <nav className="space-y-2 text-sm font-semibold">
      <button
        onClick={() => setView("APPOINTMENTS")}
        className={`text-left w-full px-4 py-3 rounded-xl transition flex items-center gap-3 ${
          view === "APPOINTMENTS"
            ? "bg-white/10 backdrop-blur text-white font-bold"
            : "text-slate-400 hover:bg-white/5 hover:text-white"
        }`}
      >
        <i className="fa-solid fa-calendar-check text-sm text-teal-400"></i>
        <span>Admin &amp; Appointments</span>
      </button>

      <button
        onClick={() => setView("HOME")}
        className={`text-left w-full px-4 py-3 rounded-xl transition flex items-center gap-3 ${
          view === "HOME"
            ? "bg-white/10 backdrop-blur text-white font-bold"
            : "text-slate-400 hover:bg-white/5 hover:text-white"
        }`}
      >
        <i className="fa-solid fa-users text-sm text-blue-400"></i>
        <span>Patients &amp; Case Sheets</span>
      </button>

      <button
        onClick={() => setView("PHARMACY")}
        className={`text-left w-full px-4 py-3 rounded-xl transition flex items-center gap-3 ${
          view === "PHARMACY"
            ? "bg-white/10 backdrop-blur text-white font-bold"
            : "text-slate-400 hover:bg-white/5 hover:text-white"
        }`}
      >
        <i className="fa-solid fa-pills text-sm text-amber-400"></i>
        <span>Pharmacy Inventory</span>
      </button>

      <button
        onClick={() => setView("PRESCRIPTION")}
        className={`text-left w-full px-4 py-3 rounded-xl transition flex items-center gap-3 ${
          view === "PRESCRIPTION"
            ? "bg-white/10 backdrop-blur text-white font-bold"
            : "text-slate-400 hover:bg-white/5 hover:text-white"
        }`}
      >
        <i className="fa-solid fa-file-prescription text-sm text-purple-400"></i>
        <span>E-Prescriptions</span>
      </button>
    </nav>

    <div className="mt-auto pt-4 border-t border-white/10 space-y-2 text-xs">
      <div className="px-3 py-2.5 rounded-xl bg-white/5 border border-white/10">
        <div className="flex items-center justify-between">
          <span className="font-bold text-slate-200">Prana Homeo Care</span>
          <span className="text-[9px] font-black px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
            Live Sync
          </span>
        </div>
        <p className="text-[10px] text-slate-400 mt-1">Kattupakkam &amp; Online Clinic</p>
      </div>

      <button
        onClick={() => {
          auth.signOut();
          setView("LOGIN");
        }}
        className="w-full py-2.5 px-3 rounded-xl bg-red-500/10 hover:bg-red-500/20 text-red-400 font-bold text-xs transition flex items-center justify-center gap-2"
      >
        <i className="fa-solid fa-arrow-right-from-bracket"></i>
        <span>Sign Out</span>
      </button>
    </div>
  </aside>

  {/* MAIN CONTENT */}
  <div
    id="appContainer"
    className="flex-1 relative overflow-x-hidden overflow-y-auto h-screen"

  >

          {view === 'LOGIN' && <Login />}

          {view === 'APPOINTMENTS' && (
            <AppointmentsAdmin
              db={db}
              setView={setView}
              setActivePatientId={setActivePatientId}
              setRegModal={setRegModal}
            />
          )}

          {view === 'HOME' && (
            <Home
              db={db}
              search={search}
              setSearch={setSearch}
              setActivePatientId={setActivePatientId}
              setView={setView}
              regModal={regModal}
              setRegModal={setRegModal}
              clinic={clinic}
              setClinic={setClinic}
              setDb={setDb}
              loadingPatients={loadingPatients}
            />


          )}


          {view === 'TIMELINE' && <Timeline patient={patient} />}

          {view === 'CONSULTATION' && <Consultation />}

          {view === 'REPORT' && <Report />}

{view === "PHARMACY" && <Pharmacy />}

{view === "PRESCRIPTION" && <Prescription />}
          {regModal.show && <RegistrationModal />}
          {pharmacyModal.show && <PharmacyModal />}

{appAlert && (
            <div className="fixed inset-0 z-[600] flex items-center justify-center px-6">
              <div
                className="absolute inset-0 bg-black/50 backdrop-blur-sm"
                onClick={() => setAppAlert(null)}
              ></div>
              <div className="relative bg-white w-full max-w-[340px] rounded-3xl p-8 shadow-2xl text-center">
                <div className="w-14 h-14 rounded-2xl bg-red-50 flex items-center justify-center mx-auto mb-5">
                  <i className="fa-solid fa-triangle-exclamation text-red-500 text-xl"></i>
                </div>
                <h3 className="text-base font-black text-slate-900 mb-2 tracking-tight">
                  Duplicate Reg ID
                </h3>
                <p className="text-sm text-slate-500 mb-7 leading-relaxed">
                  {appAlert}
                </p>
                <button
                  onClick={() => setAppAlert(null)}
                  className="w-full h-12 rounded-2xl bg-slate-900 text-white font-black text-xs uppercase tracking-widest active:scale-[0.97] transition"
                >
                  OK, Got It
                </button>
              </div>
            </div>
          )}
          
          <ConfirmModal />
</div>
        </div>
      );


    };



    const root = ReactDOM.createRoot(document.getElementById('root'));
    root.render(<App />);
  </script>
  <script>
    if ("serviceWorker" in navigator) {
      navigator.serviceWorker.register("sw.js");
    }
  </script>

</body>

</html>
