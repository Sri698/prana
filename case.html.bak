</div>
{/* ===== LOW STOCK ALERT BANNER ===== */}
{lowStock.length > 0 && (
  <div className="px-6 md:px-12 pt-4">
    <div className="bg-red-50 border border-red-100 rounded-2xl p-4">
      <p className="text-red-600 font-bold text-xs uppercase">
