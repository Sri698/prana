            </div>
            <button onClick={() => { setActiveVisitId(null); setView('CONSULTATION'); }} className="btn-primary mb-8 bg-blue-600 h-12 text-sm">NEW CONSULTATION</button>
            <div className="space-y-4">
              {(patient.history ?? []).map(v => (
                <div key={v.id} 
                
                 className="glass-card border-l-4 border-l-slate-900">
                  <div className="flex justify-between items-center mb-1">
                    <p className="text-[9px] font-black text-slate-400 uppercase">{v.date}</p>
                    <div className="flex gap-3">

                      {/* EDIT */}
                    <button
  onClick={(e) => {
    e.stopPropagation();
    setConfirmModal({
