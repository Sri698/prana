# Disable execution of scripts in uploads directory for security
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Allow public access to image and pdf files
<FilesMatch "(?i)\.(jpg|jpeg|png|gif|webp|svg|pdf)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>
